## Washmachine .gitignore

# Build output
[Oo]bj/
Output/
[Bb]in/

# IDE / Editor
.vs/
.idea/
.vscode/
*.suo
*.user
*.userosscache
*.sln.docstates
*.rsuser
*.userprefs

# NuGet
*.nupkg
*.snupkg
project.lock.json
project.fragment.lock.json

# MSBuild logs
*.binlog
[Bb]uild[Ll]og.*

# Test results
[Tt]est[Rr]esult*/
TestResult.xml
nunit-*.xml
CodeCoverage/

# OS / temp
~$*
*~
Thumbs.db
.DS_Store
*.tmp
*.bak
*.swp
*.env

# Publish artifacts (built locally)
publish/

# Crash dumps
mono_crash.*

# Per-session build artifacts (logs, generated .cpp, build/ subdir)
Output/sessions/
**/logging/
!/Logging/

# build.ps1 run logs
Logs/

# Test artifacts
test_results.json
messagebox.bin
!testing assets/binary/shellcodes/messagebox.bin
testing assets/
Backdooring/
SuperMega-main/

# Build output
Output/
last status.txt

# AI assistant sessions
.claude/

# Bundled LLVM binaries (~340 MB) — provision locally via build.ps1 or copy from C:\Program Files\LLVM\bin
Tools/LLVM/bin/*.exe
Tools/LLVM/bin/*.dll

# MinGW-w64 + LLVM build toolchain (~1 GB trimmed) — auto-provisioned by
# Assets/llvm-passes/build-all.ps1; do NOT commit (too large for git).
Tools/msys64/

# LLVM SDK download cache — staged by Assets/llvm-passes/build-all.ps1
.llvm-sdk-cache/

# LLVM pass plugin build artefacts
Assets/llvm-passes/*/build/
Assets/llvm-passes/*/pass.dll
