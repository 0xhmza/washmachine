<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <BaseOutputPath>C:\Users\hamza\Documents\GitHub\washmachine\Output</BaseOutputPath>
    <RootNamespace>Washmachine</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <SignAssembly>False</SignAssembly>
    <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
    <ProduceReferenceAssembly>False</ProduceReferenceAssembly>
    <PublishAll Condition="'$(PublishAll)'==''">false</PublishAll>
    <PublishAllPass Condition="'$(PublishAllPass)'==''">false</PublishAllPass>
    <PublishDirSingle Condition="'$(PublishDirSingle)'==''">$(BaseOutputPath)\$(Configuration)\publish\single\</PublishDirSingle>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <DebugType>none</DebugType>
    <WarningLevel>6</WarningLevel>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DebugType>none</DebugType>
    <WarningLevel>6</WarningLevel>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <StripSymbols>true</StripSymbols>
    <PublishDir>$(BaseOutputPath)\Release\publish\multi\</PublishDir>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\vx_api_snippets.yaml"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             ExcludeFromSingleFile="true" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.2.0" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>

  <Target Name="PublishSingleFileVariant"
          AfterTargets="Publish"
          Condition="'$(PublishAll)'=='true' and '$(PublishAllPass)'!='true'">
    <MSBuild Projects="$(MSBuildProjectFullPath)"
             Targets="Publish"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained);PublishSingleFile=true;PublishDir=$(PublishDirSingle);PublishAll=false;PublishAllPass=true" />
  </Target>

</Project>
