<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Washmachine.Cli</RootNamespace>

    <!-- Product metadata -->
    <AssemblyName>washmachine-cli</AssemblyName>
    <Product>Washmachine CLI</Product>
    <Description>Washmachine command-line interface for shellcode loader building</Description>
    <Version>1.0.0</Version>
    <ApplicationIcon>..\Icon\washmachine.ico</ApplicationIcon>

    <!-- Deterministic builds -->
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=.</PathMap>

    <!-- Output under repo-root Output/cli/ so CLI artifacts stay separate from GUI -->
    <BaseOutputPath>$(MSBuildProjectDirectory)\..\Output\cli</BaseOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <DebugType>portable</DebugType>
    <WarningLevel>6</WarningLevel>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <WarningLevel>6</WarningLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Optimize>true</Optimize>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <StripSymbols>true</StripSymbols>
    <PublishDir>$(BaseOutputPath)\publish\</PublishDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Washmachine.Core\Washmachine.Core.csproj" />
  </ItemGroup>

  <!-- Copy shared assets (YAML catalogs) to CLI output so AppPaths can locate them -->
  <ItemGroup>
    <Content Include="..\Assets\**\*" Link="Assets\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\testing assets\binary\shellcodes\messagebox.bin" Link="messagebox.bin" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="*" />
  </ItemGroup>
  <!-- After building CLI, copy all output files next to washmachine.exe (GUI output dir) -->
  <Target Name="CopyCliToGuiOutput" AfterTargets="Build">
    <PropertyGroup>
      <GuiOutputDir>$(MSBuildProjectDirectory)\..\Output\$(Configuration)\net8.0-windows10.0.19041.0\</GuiOutputDir>
    </PropertyGroup>
    <MakeDir Directories="$(GuiOutputDir)" Condition="!Exists('$(GuiOutputDir)')" />
    <ItemGroup>
      <_CliFiles Include="$(OutputPath)\washmachine-cli.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_CliFiles)" DestinationFolder="$(GuiOutputDir)" SkipUnchangedFiles="true" ContinueOnError="true" />
  </Target>

</Project>
