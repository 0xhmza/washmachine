<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Washmachine.Cli</RootNamespace>

    <!-- Product metadata -->
    <AssemblyName>washmachine-cli</AssemblyName>
    <Product>Washmachine CLI</Product>
    <Description>Washmachine command-line interface for shellcode loader building</Description>
    <Version>1.0.0</Version>
    <ApplicationIcon>..\Icon\washmachine.ico</ApplicationIcon>

    <!-- Deterministic builds -->
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=.</PathMap>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <DebugType>portable</DebugType>
    <WarningLevel>6</WarningLevel>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <WarningLevel>6</WarningLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Optimize>true</Optimize>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <StripSymbols>true</StripSymbols>
    <PublishDir>$(BaseOutputPath)Release\publish\</PublishDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Washmachine.Core\Washmachine.Core.csproj" />
  </ItemGroup>

  <!-- Copy shared assets (YAML catalogs) to CLI output so AppPaths can locate them -->
  <ItemGroup>
    <Content Include="..\Assets\**\*" Link="Assets\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\testing assets\binary\shellcodes\messagebox.bin" Link="messagebox.bin" CopyToOutputDirectory="PreserveNewest"
              Condition="Exists('..\testing assets\binary\shellcodes\messagebox.bin')" />
  </ItemGroup>

  <!-- Copy bundled LLVM tools to CLI output so LlvmPipelineService can locate them -->
  <ItemGroup>
    <Content Include="..\Tools\LLVM\**\*" Link="Tools\LLVM\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             Condition="Exists('..\Tools\LLVM')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.49.1" />
  </ItemGroup>

</Project>
