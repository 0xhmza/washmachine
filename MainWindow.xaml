<ui:FluentWindow x:Class="Washmachine.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:local="clr-namespace:Washmachine"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:Washmachine.Views"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 mc:Ignorable="d"
                 ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
                 ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 Title="Washmachine - Loader Builder"
                 Width="980"
                 Height="820"
                 MinWidth="920"
                 MinHeight="760"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 ExtendsContentIntoTitleBar="True"
                 Background="Transparent">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="Washmachine - Loader Builder" VerticalAlignment="Center" />

        <ui:NavigationView x:Name="mainNavigationView"
                           Grid.Row="1"
                           Background="Transparent"
                           PaneDisplayMode="Left"
                           IsPaneOpen="True"
                           IsPaneToggleVisible="True"
                           IsBackButtonVisible="Collapsed"
                           PaneTitle="Washmachine"
                           OpenPaneLength="240"
                           CompactPaneLength="56"
                           Transition="FadeInWithSlide"
                           TransitionDuration="280">
            <ui:NavigationView.PaneHeader>
                <StackPanel Orientation="Horizontal" Margin="12,16,12,8">
                    <ui:SymbolIcon Symbol="{x:Static ui:SymbolRegular.Wrench24}" FontSize="20" />
                    <StackPanel Margin="10,0,0,0">
                        <ui:TextBlock Text="Washmachine" FontSize="16" FontWeight="SemiBold" />
                        <ui:TextBlock Text="Loader Builder" FontSize="12"
                                      Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                    </StackPanel>
                </StackPanel>
            </ui:NavigationView.PaneHeader>

            <ui:NavigationView.PaneFooter>
                <StackPanel Margin="12,8,12,12">
                    <ui:TextBlock Text="Github: 0xhmza" FontSize="12"
                                  Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                </StackPanel>
            </ui:NavigationView.PaneFooter>

            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="Main"
                                       TargetPageType="{x:Type views:MainPage}"
                                       NavigationCacheMode="Required"
                                       IsActive="True">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="{x:Static ui:SymbolRegular.Home24}" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Packing"
                                       TargetPageType="{x:Type views:PackingPage}"
                                       NavigationCacheMode="Required">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="{x:Static ui:SymbolRegular.Box24}" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Backdooring"
                                       TargetPageType="{x:Type views:BackdooringPage}"
                                       NavigationCacheMode="Required">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="{x:Static ui:SymbolRegular.ShieldLock24}" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
