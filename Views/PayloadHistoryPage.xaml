<Page x:Class="Washmachine.Views.PayloadHistoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      NavigationCacheMode="Enabled">

    <Grid Background="Transparent">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,32,0,0">
            <StackPanel Margin="{StaticResource PageMargin}"
                        Orientation="Vertical"
                        HorizontalAlignment="Stretch">

                <StackPanel Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <FontIcon Glyph="&#xE80F;" FontSize="11" Margin="0,2,4,0" VerticalAlignment="Center"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="Pipeline" Margin="2,0,0,0" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text=" › " Margin="0,0,5,0" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Payload History" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Margin="0,20,0,10" Orientation="Horizontal" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE81C;" FontSize="30" Margin="0,2,12,0" />
                        <StackPanel>
                            <TextBlock Text="Generated Payload History" Style="{StaticResource PageTitleText}" />
                            <TextBlock Text="All web payload generations with full payload and Bin2Shell details."
                                       Style="{StaticResource PageSubtitleText}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <Border Style="{StaticResource CardBorder}">
                    <Grid Margin="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="History Entries" Style="{StaticResource SectionTitleText}" />
                                <Button Grid.Column="1"
                                        Content="Refresh"
                                        Click="Refresh_Click"
                                        MinWidth="90" />
                            </Grid>

                            <TextBlock x:Name="StatusText"
                                       Style="{StaticResource SectionSubtitleText}"
                                       TextWrapping="Wrap" />

                            <TextBlock x:Name="EmptyStateText"
                                       Text="No generated payload history yet."
                                       Style="{StaticResource SectionSubtitleText}"
                                       Visibility="Collapsed" />

                            <ListView x:Name="HistoryList"
                                      SelectionChanged="HistoryList_SelectionChanged"
                                      MinHeight="640">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,6" Margin="0,0,0,4"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding DisplaySubtitle}"
                                                           Style="{StaticResource SectionSubtitleText}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Spacing="10">
                            <TextBlock x:Name="NoSelectionText"
                                       Text="Select an entry to view full details."
                                       Style="{StaticResource SectionSubtitleText}" />

                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="DetailsHost"
                                            Spacing="10"
                                            Visibility="Collapsed">
                                    <Border Style="{StaticResource CardBorder}">
                                        <StackPanel Margin="12" Spacing="8">
                                            <TextBlock Text="Summary" Style="{StaticResource SectionTitleText}" />

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <TextBlock Text="Generated at" Grid.Row="0" Style="{StaticResource SectionSubtitleText}" />
                                                <TextBlock x:Name="GeneratedAtValue" Grid.Row="0" Grid.Column="1" TextWrapping="Wrap" />

                                                <TextBlock Text="Payload URL" Grid.Row="1" Style="{StaticResource SectionSubtitleText}" />
                                                <TextBlock x:Name="PayloadUrlValue" Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" />

                                                <TextBlock Text="Source file" Grid.Row="2" Style="{StaticResource SectionSubtitleText}" />
                                                <TextBlock x:Name="SourcePathValue" Grid.Row="2" Grid.Column="1" TextWrapping="Wrap" />

                                                <TextBlock Text="Source size" Grid.Row="3" Style="{StaticResource SectionSubtitleText}" />
                                                <TextBlock x:Name="SourceSizeValue" Grid.Row="3" Grid.Column="1" TextWrapping="Wrap" />

                                                <TextBlock Text="Source SHA-256" Grid.Row="4" Style="{StaticResource SectionSubtitleText}" />
                                                <TextBlock x:Name="SourceHashValue" Grid.Row="4" Grid.Column="1" TextWrapping="Wrap" />

                                                <TextBlock Text="Encoder" Grid.Row="5" Style="{StaticResource SectionSubtitleText}" />
                                                <TextBlock x:Name="EncoderValue" Grid.Row="5" Grid.Column="1" TextWrapping="Wrap" />

                                                <TextBlock Text="Envelope" Grid.Row="6" Style="{StaticResource SectionSubtitleText}" />
                                                <TextBlock x:Name="EnvelopeValue" Grid.Row="6" Grid.Column="1" TextWrapping="Wrap" />

                                                <TextBlock Text="Web helper" Grid.Row="7" Style="{StaticResource SectionSubtitleText}" />
                                                <TextBlock x:Name="WebHelperValue" Grid.Row="7" Grid.Column="1" TextWrapping="Wrap" />

                                                <TextBlock Text="Payload length" Grid.Row="8" Style="{StaticResource SectionSubtitleText}" />
                                                <TextBlock x:Name="PayloadBytesValue" Grid.Row="8" Grid.Column="1" TextWrapping="Wrap" />

                                                <TextBlock Text="Payload checksum" Grid.Row="9" Style="{StaticResource SectionSubtitleText}" />
                                                <TextBlock x:Name="PayloadChecksumValue" Grid.Row="9" Grid.Column="1" TextWrapping="Wrap" />

                                                <TextBlock Text="History file" Grid.Row="10" Style="{StaticResource SectionSubtitleText}" />
                                                <TextBlock x:Name="HistoryPathValue" Grid.Row="10" Grid.Column="1" TextWrapping="Wrap" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Expander Header="Bin2Shell command line" IsExpanded="False">
                                        <TextBox x:Name="CommandLineTextBox"
                                                 FontFamily="Cascadia Mono, Consolas, Courier New"
                                                 IsReadOnly="True"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 MinHeight="80" />
                                    </Expander>

                                    <Expander Header="Payload bytes/text" IsExpanded="False">
                                        <TextBox x:Name="PayloadTextBox"
                                                 FontFamily="Cascadia Mono, Consolas, Courier New"
                                                 IsReadOnly="True"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 MinHeight="120" />
                                    </Expander>

                                    <Expander Header="C++ includes (cpp_includes)" IsExpanded="False">
                                        <TextBox x:Name="CppIncludesTextBox"
                                                 FontFamily="Cascadia Mono, Consolas, Courier New"
                                                 IsReadOnly="True"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 MinHeight="100" />
                                    </Expander>

                                    <Expander Header="C++ declarations (cpp_declarations)" IsExpanded="False">
                                        <TextBox x:Name="CppDeclarationsTextBox"
                                                 FontFamily="Cascadia Mono, Consolas, Courier New"
                                                 IsReadOnly="True"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 MinHeight="100" />
                                    </Expander>

                                    <Expander Header="C++ web fetch helper (cpp_web_fetch)" IsExpanded="False">
                                        <TextBox x:Name="CppWebFetchTextBox"
                                                 FontFamily="Cascadia Mono, Consolas, Courier New"
                                                 IsReadOnly="True"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 MinHeight="100" />
                                    </Expander>

                                    <Expander Header="C++ payload init (cpp_payload_init)" IsExpanded="False">
                                        <TextBox x:Name="CppPayloadInitTextBox"
                                                 FontFamily="Cascadia Mono, Consolas, Courier New"
                                                 IsReadOnly="True"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 MinHeight="100" />
                                    </Expander>

                                    <Expander Header="C++ decode stage (cpp_decode)" IsExpanded="False">
                                        <TextBox x:Name="CppDecodeTextBox"
                                                 FontFamily="Cascadia Mono, Consolas, Courier New"
                                                 IsReadOnly="True"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 MinHeight="100" />
                                    </Expander>

                                    <Expander Header="Compiled preamble block" IsExpanded="False">
                                        <TextBox x:Name="CppPreambleTextBox"
                                                 FontFamily="Cascadia Mono, Consolas, Courier New"
                                                 IsReadOnly="True"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 MinHeight="100" />
                                    </Expander>

                                    <Expander Header="Compiled body block" IsExpanded="False">
                                        <TextBox x:Name="CppBodyTextBox"
                                                 FontFamily="Cascadia Mono, Consolas, Courier New"
                                                 IsReadOnly="True"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 MinHeight="100" />
                                    </Expander>
                                </StackPanel>
                            </ScrollViewer>
                        </StackPanel>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
