<Page x:Class="Washmachine.Views.CompilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Washmachine"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      NavigationCacheMode="Required">

    <Grid x:Name="Root" Background="Transparent">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,32,0,0">
            <StackPanel Margin="{StaticResource PageMargin}"
                        Orientation="Vertical"
                        Width="{StaticResource ContentMaxWidth}"
                        HorizontalAlignment="Center">

                <!-- Page header -->
                <StackPanel Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <FontIcon Glyph="&#xE80F;" FontSize="11" Margin="0,2,4,0" VerticalAlignment="Center"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="Pipeline" Margin="2,0,0,0" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text=" › " Margin="0,0,5,0" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Compile" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Margin="0,20,0,20" Orientation="Horizontal" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE90F;" FontSize="30" Margin="0,2,12,0" />
                        <StackPanel>
                            <TextBlock Text="Build Pipeline" Style="{StaticResource PageTitleText}" />
                            <TextBlock Text="Compile, backdoor, and pack your configured payload."
                                       Style="{StaticResource PageSubtitleText}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <Border Margin="10,10,10,15"/>

                <!-- Pipeline Configuration Summary -->
                <Expander IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,0,4">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <FontIcon Glyph="&#xE946;" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Pipeline Configuration" Style="{StaticResource SectionTitleText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Spacing="12" Margin="0,12,0,4">

                        <!-- Payload Summary -->
                        <Border Style="{StaticResource CardBorder}">
                            <Grid Margin="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE943;" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center"
                                          Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="1. Payload" FontWeight="SemiBold" />
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Shellcode:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="SummaryShellcode" Text="Not configured" Grid.Column="1" />
                                        <TextBlock Text="Template:" Grid.Row="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="SummaryTemplate" Text="Not selected" Grid.Row="1" Grid.Column="1" />
                                        <TextBlock Text="Encoder:" Grid.Row="2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="SummaryEncoder" Text="None" Grid.Row="2" Grid.Column="1" />
                                        <TextBlock Text="Envelope:" Grid.Row="3" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="SummaryEnvelope" Text="None" Grid.Row="3" Grid.Column="1" />
                                    </Grid>
                                </StackPanel>
                                <HyperlinkButton Grid.Column="2" Content="Edit" VerticalAlignment="Top" Click="GoToPayload_Click" />
                            </Grid>
                        </Border>

                        <!-- Backdooring Summary -->
                        <Border x:Name="BackdoorSummaryCard" Style="{StaticResource CardBorder}" Opacity="0.5">
                            <Grid Margin="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE8AC;" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center"
                                          Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                <StackPanel Grid.Column="1">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="2. Backdooring" FontWeight="SemiBold" />
                                        <Border x:Name="BackdoorStatusBadge" 
                                                Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                                CornerRadius="2" Padding="6,2">
                                            <TextBlock x:Name="BackdoorStatusText" Text="Disabled" FontSize="11" />
                                        </Border>
                                    </StackPanel>
                                    <Grid x:Name="BackdoorDetails" Margin="0,8,0,0" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Target:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="SummaryTargetPe" Text="Not selected" Grid.Column="1" />
                                        <TextBlock Text="Method:" Grid.Row="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="SummaryInjectionMethod" Text="New Section" Grid.Row="1" Grid.Column="1" />
                                        <TextBlock Text="Carrier:" Grid.Row="2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="SummaryCarrier" Text="Entry Point Hijack" Grid.Row="2" Grid.Column="1" />
                                    </Grid>
                                    <TextBlock x:Name="BackdoorDisabledText" 
                                               Text="Backdooring is disabled. Output will be a standalone loader."
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               FontSize="12"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                                <HyperlinkButton Grid.Column="2" Content="Edit" VerticalAlignment="Top" Click="GoToBackdooring_Click" />
                            </Grid>
                        </Border>

                        <!-- Packing Summary -->
                        <Border x:Name="PackingSummaryCard" Style="{StaticResource CardBorder}" Opacity="0.5">
                            <Grid Margin="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE7B8;" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center"
                                          Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                <StackPanel Grid.Column="1">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="3. Packing" FontWeight="SemiBold" />
                                        <Border x:Name="PackingStatusBadge" 
                                                Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                                CornerRadius="2" Padding="6,2">
                                            <TextBlock x:Name="PackingStatusText" Text="Disabled" FontSize="11" />
                                        </Border>
                                    </StackPanel>
                                    <Grid x:Name="PackingDetails" Margin="0,8,0,0" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition />
                                            <RowDefinition />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Packer:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="SummaryPacker" Text="UPX" Grid.Column="1" />
                                        <TextBlock Text="Level:" Grid.Row="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="SummaryPackLevel" Text="Best" Grid.Row="1" Grid.Column="1" />
                                    </Grid>
                                    <TextBlock x:Name="PackingDisabledText" 
                                               Text="Packing is disabled. Output will not be compressed."
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               FontSize="12"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                                <HyperlinkButton Grid.Column="2" Content="Edit" VerticalAlignment="Top" Click="GoToPacking_Click" />
                            </Grid>
                        </Border>

                    </StackPanel>
                </Expander>

                

                <Border Margin="0,0,0,0"/>

                <!-- Compiler Selection (cards) -->
                <Expander IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,0,4">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <FontIcon Glyph="&#xE74E;" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Compiler Toolchain" Style="{StaticResource SectionTitleText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Margin="0,12,0,4" Spacing="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Pick a compiler — selecting LLVM unlocks the obfuscation pipeline."
                                       Style="{StaticResource SectionSubtitleText}"
                                       VerticalAlignment="Center" />
                            <Button x:Name="RefreshCompilerButton" Grid.Column="1" MinWidth="100"
                                    Click="RefreshCompiler_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE72C;" FontSize="13" />
                                    <TextBlock Text="Detect" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Cards list -->
                        <ListView x:Name="CompilerCardsList"
                                  SelectionMode="Single"
                                  HorizontalAlignment="Stretch"
                                  SelectionChanged="CompilerCardsList_SelectionChanged"
                                  IsItemClickEnabled="True"
                                  IsTabStop="False"
                                  Background="Transparent"
                                  Padding="0">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,6" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="36" Height="36" CornerRadius="6"
                                                    Background="{Binding AccentBrush}"
                                                    VerticalAlignment="Center" Margin="0,0,12,0">
                                                <FontIcon Glyph="{Binding Glyph}" FontSize="16"
                                                          Foreground="White"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding Kind}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                                                    <Border Background="{ThemeResource SystemFillColorSolidNeutralBackgroundBrush}"
                                                            CornerRadius="3" Padding="6,1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Edition}" FontSize="10" />
                                                    </Border>
                                                    <Border Background="{Binding BackendBadgeBrush}"
                                                            CornerRadius="3" Padding="6,1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding BackendBadge}" FontSize="10" Foreground="White" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Path}"
                                                           FontSize="11"
                                                           FontFamily="Consolas"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- Empty / scanning placeholder -->
                        <Border x:Name="NoCompilerCard"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="14"
                                Visibility="Collapsed">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE783;" FontSize="14"
                                              Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                    <TextBlock Text="No compiler detected" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="Install MSVC / MinGW / LLVM, or drop a bundled LLVM into Tools\LLVM\bin\."
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="CompilerStatus"
                                   Style="{StaticResource SectionSubtitleText}" />

                        <!-- Download Compiler -->
                        <Border x:Name="DownloadCompilerPanel"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="6"
                                Padding="12"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="No Compiler Found" FontWeight="SemiBold" />
                                    <TextBlock Text="Download a portable MinGW-w64 compiler from GitHub."
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <Button x:Name="DownloadCompilerButton"
                                        Content="Download Compiler"
                                        Grid.Column="1"
                                        Click="DownloadCompiler_Click" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Expander>


                <Border Margin="0,0,0,0"/>

                <!-- LLVM Obfuscation (only shown when LLVM compiler is selected) -->
                <Expander x:Name="LlvmModeExpander"
                          IsExpanded="True"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch"
                          Visibility="Collapsed"
                          Margin="0,0,0,4">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <FontIcon Glyph="&#xE9D3;" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="LLVM Obfuscation" Style="{StaticResource SectionTitleText}" VerticalAlignment="Center" />
                            <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    CornerRadius="3" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="LLVM ONLY" FontSize="10" Foreground="White" />
                            </Border>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Margin="0,12,0,4" Spacing="12">
                        <TextBlock Text="IR-level passes injected via -fpass-plugin. Toggle any combination — unbuilt passes are skipped by the pipeline with a warning."
                                   Style="{StaticResource SectionSubtitleText}"
                                   TextWrapping="Wrap" />
                        <StackPanel x:Name="LlvmPassesPanel" Spacing="8">
                            <TextBlock x:Name="LlvmPassesNote"
                                           Text="Passes marked STUB are not yet compiled and will be skipped by the pipeline. Build with Assets/llvm-passes/build-all.ps1 to activate them."
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Available passes" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="All" MinWidth="60" Margin="0,0,6,0"
                                        Click="LlvmSelectAllPasses_Click" />
                                <Button Grid.Column="2" Content="None" MinWidth="60"
                                        Click="LlvmClearAllPasses_Click" />
                            </Grid>
                            <StackPanel x:Name="LlvmPassCheckboxes" Spacing="6" />
                        </StackPanel>

                        <Border Style="{StaticResource SectionDivider}" Margin="0,4,0,0" />

                        <StackPanel Spacing="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Time stretch — execution slowdown" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Border x:Name="TimeStretchStatusBadge" CornerRadius="3" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="TimeStretchStatusText" FontSize="10" Foreground="White" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Grid.Column="1" x:Name="SlowdownValueLabel"
                                           Text="off" MinWidth="48"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                            <TextBlock Text="Inserts data-dependent integer-arithmetic chains at function entries to consume real cycles. Looks statistically like normal hashing/mixer code — no cpuid, rdtsc, fences, NOP sleds, or spin loops. Slowdown scales with the program's own call frequency. Level × 2 = arithmetic ops per function entry (max 200 at level 100). 0 disables the pass."
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                            <Slider x:Name="SlowdownSlider"
                                    Minimum="0" Maximum="100" Value="0"
                                    StepFrequency="1" SmallChange="1" LargeChange="10"
                                    TickFrequency="10" TickPlacement="Outside"
                                    ValueChanged="SlowdownSlider_ValueChanged" />
                        </StackPanel>

                        <Border Style="{StaticResource SectionDivider}" Margin="0,4,0,0" />

                        <TextBlock Text="Toolchain mode" FontWeight="SemiBold" />
                        <RadioButtons x:Name="LlvmToolchainRadio" SelectedIndex="0">
                            <x:String>Auto (clang-cl if MSVC available, else clang++)</x:String>
                            <x:String>Force clang-cl (MSVC ABI)</x:String>
                            <x:String>Force clang++ (MinGW target)</x:String>
                        </RadioButtons>
                    </StackPanel>
                </Expander>

                <Border Margin="0,0,0,0"/>

                <!-- Compilation Controls (universal) -->
                <Expander IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,0,4">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <FontIcon Glyph="&#xE713;" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Compilation Flow" Style="{StaticResource SectionTitleText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Margin="0,12,0,4" Spacing="12">

                        <Grid ColumnSpacing="12" RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="Optimization" Style="{StaticResource SectionSubtitleText}" Margin="0,0,0,4" />
                                <ComboBox x:Name="OptimizationCombo" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="O0 — no optimization" Tag="O0" />
                                    <ComboBoxItem Content="O1 — basic"          Tag="O1" />
                                    <ComboBoxItem Content="O2 — recommended"    Tag="O2" IsSelected="True" />
                                    <ComboBoxItem Content="O3 — aggressive"     Tag="O3" />
                                    <ComboBoxItem Content="Os — size"           Tag="Os" />
                                    <ComboBoxItem Content="Oz — smallest"       Tag="Oz" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1">
                                <TextBlock Text="Architecture" Style="{StaticResource SectionSubtitleText}" Margin="0,0,0,4" />
                                <ComboBox x:Name="ArchitectureCombo" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="x86_64 (64-bit)" Tag="x64" IsSelected="True" />
                                    <ComboBoxItem Content="i686 (32-bit)"   Tag="x86" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="Subsystem" Style="{StaticResource SectionSubtitleText}" Margin="0,0,0,4" />
                                <ComboBox x:Name="SubsystemCombo" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="Windows (no console)" Tag="windows" IsSelected="True" />
                                    <ComboBoxItem Content="Console"              Tag="console" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0">
                                <TextBlock Text="C++ Standard" Style="{StaticResource SectionSubtitleText}" Margin="0,0,0,4" />
                                <ComboBox x:Name="CppStandardCombo" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="C++14" Tag="14" />
                                    <ComboBoxItem Content="C++17" Tag="17" IsSelected="True" />
                                    <ComboBoxItem Content="C++20" Tag="20" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2">
                                <TextBlock Text="Preprocessor defines (comma- or space-separated, e.g. NDEBUG, FOO=1)" Style="{StaticResource SectionSubtitleText}" Margin="0,0,0,4" />
                                <TextBox x:Name="DefinesTextBox" PlaceholderText="NDEBUG, WASH_QUIET" />
                            </StackPanel>
                        </Grid>

                        <StackPanel>
                            <TextBlock Text="Extra compiler flags (passed verbatim — power users only)"
                                       Style="{StaticResource SectionSubtitleText}" Margin="0,0,0,4" />
                            <TextBox x:Name="ExtraFlagsTextBox" PlaceholderText="-Wno-unused-variable -fvisibility=hidden" />
                        </StackPanel>

                        <Border Style="{StaticResource SectionDivider}" Margin="0,0,0,0" />

                        <!-- Toggles row -->
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="6">
                                <CheckBox x:Name="StripSymbolsCheck" Content="Strip symbols from binary" IsChecked="True"
                                          ToolTipService.ToolTip="Drops debug/symbol tables to shrink and harden the output binary" />
                                <CheckBox x:Name="LtoCheck" Content="Link-time optimization (LTO)" IsChecked="False"
                                          ToolTipService.ToolTip="Enables -flto. LLVM only — ignored on MSVC/MinGW paths." />
                                <CheckBox x:Name="GcSectionsCheck" Content="Garbage-collect dead sections" IsChecked="True"
                                          ToolTipService.ToolTip="Adds -ffunction-sections -fdata-sections + --gc-sections to drop unreferenced code" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6">
                                <CheckBox x:Name="GenerateDebugInfo" Content="Generate debug info (PDB)" IsChecked="False" />
                                <CheckBox x:Name="VerboseBuildCheck" Content="Verbose build output" IsChecked="False" />
                                <CheckBox x:Name="OpenFolderAfterCompile" Content="Open output folder after build" IsChecked="True" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Expander>

                <Border Margin="0,0,0,0"/>

                <!-- Output Options -->
                <Expander IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,0,4">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <FontIcon Glyph="&#xE8B7;" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Output" Style="{StaticResource SectionTitleText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Margin="0,12,0,4">
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="OutputPath" PlaceholderText="Output directory (optional)" Margin="0,0,8,0" />
                            <Button x:Name="BrowseOutput" Grid.Column="1" Content="Browse" MinWidth="90"
                                    Click="BrowseOutput_Click" />
                        </Grid>

                        <CheckBox x:Name="StripToBinCheck" Content="Also strip compiled loader to flat .bin (shellcode-ready for injection)" IsChecked="False"
                                  ToolTipService.ToolTip="Runs the strip pipeline step after compilation to produce a position-independent .bin alongside the .exe" />
                    </StackPanel>
                </Expander>

               

                <Border Margin="0,0,0,0"/>

                <!-- Pipeline visualization moved to dedicated 'Pipeline' page in the navbar footer.
     Open it for the live cinematic readout, recipe export/import, and SGN-compat analysis. -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,4">
                    <Grid Padding="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE9D9;" FontSize="20" Margin="0,2,12,0" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Pipeline readout" Style="{StaticResource SectionTitleText}" />
                            <TextBlock Text="Live recipe view, recipe export/import, and stage analysis live on the dedicated Pipeline page."
                       Style="{StaticResource SectionSubtitleText}"
                       Margin="0,4,0,0"
                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="2"
                Content="Open Pipeline →"
                MinWidth="160"
                VerticalAlignment="Center"
                Click="OpenPipelinePage_Click" />
                    </Grid>
                </Border>

                <Border Margin="0,0,0,10"/>
                
                <!-- Build Action -->
                <Border Style="{StaticResource CardBorder}" Margin="0">
                    <StackPanel Margin="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE768;" FontSize="24" Margin="0,2,16,0" VerticalAlignment="Center"
                                      Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Build Pipeline" Style="{StaticResource SectionTitleText}" />
                                <TextBlock x:Name="BuildDescription" 
                                           Text="Bin2Shell → Template compile → Backdoor → Pack → Output"
                                           Style="{StaticResource SectionSubtitleText}"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                            <Button x:Name="CompileButton"
                                    Grid.Column="2"
                                    Content="Build"
                                    Width="160"
                                    Height="40"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Click="CompileButton_Click" />
                        </Grid>

                        <!-- Progress -->
                        <StackPanel x:Name="CompileProgressPanel" Visibility="Collapsed" Margin="0,16,0,0">
                            <ProgressBar x:Name="CompileProgress" IsIndeterminate="True" />
                            <TextBlock x:Name="CompileProgressText" Text="Building..." Margin="0,8,0,0"
                                       HorizontalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <!-- Result -->
                        <StackPanel x:Name="CompileResultPanel" Orientation="Horizontal" Margin="0,12,0,0" Visibility="Collapsed">
                            <FontIcon x:Name="CompileResultIcon" Glyph="&#xE73E;" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="CompileResultText" VerticalAlignment="Center" />
                            <HyperlinkButton x:Name="CompileOutputLink" Padding="4,0" VerticalAlignment="Center"
                                             Margin="8,0,0,0" Visibility="Collapsed" Click="OpenOutputFolder_Click">
                                <TextBlock Text="Open folder" TextDecorations="Underline" />
                            </HyperlinkButton>
                        </StackPanel>
                    </StackPanel>
                </Border>


                <Border Margin="0,0,0,15"/>
                <!-- Build Log -->
                <Expander IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,0,4">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <FontIcon Glyph="&#xF0E3;" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Build Log" Style="{StaticResource SectionTitleText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Expander.Header>
                    <RichEditBox x:Name="BuildLogBox"
                                 Height="250"
                                 IsReadOnly="True"
                                 FontFamily="Consolas"
                                 FontSize="13"
                                 FlowDirection="LeftToRight"
                                 Margin="0,8,0,0" />
                </Expander>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
