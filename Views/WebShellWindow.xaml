<Window
    x:Class="Washmachine.Views.WebShellWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Washmachine.Views"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Washmachine">
    <Grid x:Name="Root" Background="#1A1A1A">
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══════ Custom title bar ═══════ -->
        <Grid Grid.Row="0" Background="#0F0F0F">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left: gradient W logo + app title -->
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        Spacing="10"
                        VerticalAlignment="Center"
                        Margin="14,0,0,0">
                <Border Width="20" Height="20" CornerRadius="4" VerticalAlignment="Center">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#60CDFF" Offset="0" />
                            <GradientStop Color="#4CC2FF" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="W"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="#003A5D"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Washmachine"
                           FontSize="12"
                           Foreground="#DBDBDB"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- Middle: drag region (fills available space) -->
            <Grid x:Name="DragRegion"
                  Grid.Column="1"
                  Background="Transparent" />

            <!-- Right: window control buttons (min / max / close) -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Stretch">
                <Button x:Name="MinBtn"
                        Width="46" Height="36"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="0"
                        Click="MinBtn_Click"
                        ToolTipService.ToolTip="Minimize">
                    <Button.Resources>
                        <ResourceDictionary>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#2A2A2A" />
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#404040" />
                            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFF" />
                            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFFFFF" />
                            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                        </ResourceDictionary>
                    </Button.Resources>
                    <Path Data="M 0,5 L 10,5" Stroke="#DBDBDB" StrokeThickness="1" />
                </Button>
                <Button x:Name="MaxBtn"
                        Width="46" Height="36"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="0"
                        Click="MaxBtn_Click"
                        ToolTipService.ToolTip="Maximize">
                    <Button.Resources>
                        <ResourceDictionary>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#2A2A2A" />
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#404040" />
                            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFF" />
                            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFFFFF" />
                            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                        </ResourceDictionary>
                    </Button.Resources>
                    <Grid>
                        <Path x:Name="MaxGlyph"
                              Data="M 0,0 L 10,0 L 10,10 L 0,10 Z"
                              Stroke="#DBDBDB"
                              StrokeThickness="1"
                              Fill="Transparent" />
                        <Path x:Name="RestoreGlyph"
                              Data="M 2,0 L 10,0 L 10,8 M 0,2 L 8,2 L 8,10 L 0,10 Z"
                              Stroke="#DBDBDB"
                              StrokeThickness="1"
                              Fill="Transparent"
                              Visibility="Collapsed" />
                    </Grid>
                </Button>
                <Button x:Name="CloseBtn"
                        Width="46" Height="36"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="0"
                        Click="CloseBtn_Click"
                        ToolTipService.ToolTip="Close">
                    <Button.Resources>
                        <ResourceDictionary>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#C42B1C" />
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#B62616" />
                            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFF" />
                            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFFFFF" />
                            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                        </ResourceDictionary>
                    </Button.Resources>
                    <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="#DBDBDB" StrokeThickness="1" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ═══════ WebView + loading overlay ═══════ -->
        <Grid Grid.Row="1">
            <controls:WebView2 x:Name="WebView" />

            <Border x:Name="LoadingOverlay"
                    Background="#1A1A1A"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="18">
                    <Border Width="56" Height="56" CornerRadius="12"
                            HorizontalAlignment="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#60CDFF" Offset="0" />
                                <GradientStop Color="#4CC2FF" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="W"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#003A5D"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <ProgressRing IsActive="True"
                                  Width="20"
                                  Height="20"
                                  Foreground="#60CDFF" />
                    <TextBlock x:Name="LoadingStatusText"
                               Text="initializing webview…"
                               FontFamily="Cascadia Code, Consolas"
                               FontSize="11"
                               Foreground="#8C8C8C"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
