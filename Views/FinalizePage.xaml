<Page x:Class="Washmachine.Views.FinalizePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      NavigationCacheMode="Required">

    <Grid Background="Transparent">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,32,0,0">
            <StackPanel Margin="{StaticResource PageMargin}"
                        Orientation="Vertical"
                        Width="{StaticResource ContentMaxWidth}"
                        HorizontalAlignment="Center">

                <!-- Page header -->
                <StackPanel Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <FontIcon Glyph="&#xE80F;" FontSize="11" Margin="0,2,4,0" VerticalAlignment="Center"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="Pipeline" Margin="2,0,0,0" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text=" › " Margin="0,0,5,0" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Finalize" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Margin="0,20,0,20" Orientation="Horizontal" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE73E;" FontSize="30" Margin="0,2,12,0" />
                        <StackPanel>
                            <TextBlock Text="Finalize Output" Style="{StaticResource PageTitleText}" />
                            <TextBlock Text="Apply post-build resource cloning and optional NOP size inflation."
                                       Style="{StaticResource PageSubtitleText}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <Border Style="{StaticResource SectionDivider}" />

                <StackPanel Spacing="16">

                    <!-- Enable toggle card -->
                    <Border Style="{StaticResource CardBorder}">
                        <Grid Padding="20,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="4,0,16,0">
                                <TextBlock Text="Enable finalization" Style="{StaticResource SectionTitleText}" />
                                <TextBlock Text="Turn on post-compilation processing for the final executable."
                                           Style="{StaticResource SectionSubtitleText}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                            <ToggleSwitch x:Name="EnableFinalizeToggle"
                                          Grid.Column="1"
                                          IsOn="False"
                                          Toggled="EnableFinalizeToggle_Toggled"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          MinWidth="0" Margin="8,0,8,0" Header="" />
                        </Grid>
                    </Border>

                    <StackPanel x:Name="FinalizeConfigPanel" Opacity="0.4" IsHitTestVisible="False" Spacing="16">

                        <!-- Clone resources -->
                        <Expander IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Clone resources and metadata" Style="{StaticResource SectionTitleText}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel Margin="0,12,0,4" Spacing="12">
                                <TextBlock Text="Import version info, icon, and resources from an existing EXE."
                                           Style="{StaticResource SectionSubtitleText}" />

                                <StackPanel Spacing="4">
                                    <TextBlock Text="Source executable" Style="{StaticResource SectionSubtitleText}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="CloneSourcePath"
                                                 PlaceholderText="Path to source .exe"
                                                 TextChanged="CloneSourcePath_TextChanged" />
                                        <Button Grid.Column="1"
                                                Content="Browse"
                                                MinWidth="90"
                                                Margin="8,0,0,0"
                                                Click="BrowseCloneSource_Click" />
                                    </Grid>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Confirm import"
                                            Click="ConfirmCloneSettings_Click" />
                                    <TextBlock x:Name="CloneSettingsStatusText"
                                               VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Text="No source selected." />
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="Apply to output" Style="{StaticResource SectionSubtitleText}" />
                                    <CheckBox x:Name="CloneResourcesCheck"
                                              Content="Generic resources"
                                              IsChecked="True" />
                                    <CheckBox x:Name="CloneIconCheck"
                                              Content="Icon resources"
                                              IsChecked="True" />
                                    <CheckBox x:Name="CloneMetadataCheck"
                                              Content="VERSIONINFO metadata"
                                              IsChecked="True" />
                                </StackPanel>
                            </StackPanel>
                        </Expander>

                        <!-- Size inflation -->
                        <Expander IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <FontIcon Glyph="&#xEC8A;" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Size inflation (NOP padding)" Style="{StaticResource SectionTitleText}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel Margin="0,12,0,4" Spacing="12">
                                <TextBlock Text="Appends 0x90 bytes to the output EXE to increase its size. Useful for evading size-based heuristics."
                                           Style="{StaticResource SectionSubtitleText}"
                                           TextWrapping="Wrap" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Enable NOP padding" FontWeight="SemiBold" />
                                        <TextBlock Text="Off disables padding even if an amount is set."
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="EnableNopPaddingToggle"
                                                  Grid.Column="1"
                                                  VerticalAlignment="Center"
                                                  Toggled="EnableNopPaddingToggle_Toggled" />
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,8,0">
                                        <TextBlock Text="Amount" Style="{StaticResource SectionSubtitleText}" />
                                        <NumberBox x:Name="NopPaddingBytesBox"
                                                   Value="0"
                                                   Minimum="0"
                                                   SmallChange="1"
                                                   SpinButtonPlacementMode="Inline"
                                                   IsEnabled="False" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="Unit" Style="{StaticResource SectionSubtitleText}" />
                                        <ComboBox x:Name="NopPaddingUnitCombo"
                                                  HorizontalAlignment="Stretch"
                                                  IsEnabled="False"
                                                  SelectedIndex="1">
                                            <ComboBoxItem Content="B" />
                                            <ComboBoxItem Content="KB" />
                                            <ComboBoxItem Content="MB" />
                                            <ComboBoxItem Content="GB" />
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Expander>

                        <!-- Next step -->
                        <Border Style="{StaticResource CardBorder}" Margin="0">
                            <StackPanel Margin="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE768;" FontSize="20" Margin="0,2,12,0" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Next: Compile" Style="{StaticResource SectionTitleText}" />
                                        <TextBlock Text="Build and apply finalize settings to the output executable."
                                                   Style="{StaticResource SectionSubtitleText}"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="2"
                                            Content="Go to Compile →"
                                            MinWidth="160"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Click="GoToCompilePage_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
