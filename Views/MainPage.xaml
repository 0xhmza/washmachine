<Page x:Class="Washmachine.Views.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Washmachine"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      NavigationCacheMode="Required">

    <Grid x:Name="Root" Background="{StaticResource N1Brush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0">
            <StackPanel Margin="{StaticResource PageMargin}"
                        Spacing="22"
                        MaxWidth="{StaticResource ContentMaxWidth}"
                        HorizontalAlignment="Stretch">

                <!-- Page header: title + sub -->
                <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Bottom">
                    <TextBlock Text="Shellcode source" Style="{StaticResource PageTitleText}" />
                    <TextBlock Text="Pick one input. Everything downstream rebuilds when this changes."
                               Style="{StaticResource PageSubtitleText}"
                               VerticalAlignment="Bottom"
                               Margin="0,0,0,8" />
                </StackPanel>

                <!-- ═══ Section: Input mode ═══ -->
                <StackPanel Spacing="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock Text="INPUT MODE" Style="{StaticResource SectionLabelText}" />
                        </StackPanel>
                    </Grid>

                    <!-- Source picker (compact tab-like selector) -->
                    <StackPanel x:Name="ShellcodeSourcePicker" Spacing="10">
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Select a source"
                                           Style="{StaticResource SectionTitleText}" />
                                <TextBlock Text="Pick exactly one source. You can change it later."
                                           Style="{StaticResource SectionSubtitleText}" />
                                <Grid Margin="0,4,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Row="0" Grid.Column="0" Margin="0,0,8,8"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                            Tag="File" Click="ShellcodeSourceSelect_Click" Padding="14,12">
                                        <StackPanel Spacing="6">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE8A5;" FontSize="14" VerticalAlignment="Center" />
                                                <TextBlock Text="File" FontWeight="SemiBold" />
                                            </StackPanel>
                                            <TextBlock Text=".bin or .exe on disk" Style="{StaticResource MonoTinyText}" />
                                        </StackPanel>
                                    </Button>

                                    <Button Grid.Row="0" Grid.Column="1" Margin="0,0,8,8"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                            Tag="Raw" Click="ShellcodeSourceSelect_Click" Padding="14,12">
                                        <StackPanel Spacing="6">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE756;" FontSize="14" VerticalAlignment="Center" />
                                                <TextBlock Text="Raw" FontWeight="SemiBold" />
                                            </StackPanel>
                                            <TextBlock Text="Paste hex bytes inline" Style="{StaticResource MonoTinyText}" />
                                        </StackPanel>
                                    </Button>

                                    <Button Grid.Row="0" Grid.Column="2" Margin="0,0,8,8"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                            Tag="Url" Click="ShellcodeSourceSelect_Click" Padding="14,12">
                                        <StackPanel Spacing="6">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE71B;" FontSize="14" VerticalAlignment="Center" />
                                                <TextBlock Text="URL" FontWeight="SemiBold" />
                                            </StackPanel>
                                            <TextBlock Text="Fetch over HTTP(S)" Style="{StaticResource MonoTinyText}" />
                                        </StackPanel>
                                    </Button>

                                    <Button Grid.Row="0" Grid.Column="3" Margin="0,0,0,8"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                            Tag="Generic" Click="ShellcodeSourceSelect_Click" Padding="14,12">
                                        <StackPanel Spacing="6">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE7B8;" FontSize="14" VerticalAlignment="Center" />
                                                <TextBlock Text="Test" FontWeight="SemiBold" />
                                            </StackPanel>
                                            <TextBlock Text="Built-in payloads" Style="{StaticResource MonoTinyText}" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Source details once selected -->
                    <StackPanel x:Name="ShellcodeSourceDetails" Visibility="Collapsed" Spacing="10">
                        <Border Style="{StaticResource CardBorder}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="280" />
                                </Grid.ColumnDefinitions>

                                <!-- Left: source inputs -->
                                <StackPanel Spacing="12" Margin="0,0,18,0">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon x:Name="ShellcodeSourceIcon" Glyph="&#xE8A5;" FontSize="14" VerticalAlignment="Center" />
                                        <TextBlock x:Name="ShellcodeSourceTitle" Text="Selected source"
                                                   Style="{StaticResource SectionTitleText}"
                                                   VerticalAlignment="Center" />
                                        <Border Style="{StaticResource ChipBorder}" VerticalAlignment="Center">
                                            <TextBlock x:Name="ShellcodeSourceSummary"
                                                       Text="none"
                                                       Style="{StaticResource ChipMonoText}" />
                                        </Border>
                                        <Border Width="0" />
                                        <Button Content="Change source"
                                                HorizontalAlignment="Right"
                                                Click="ChangeShellcodeSource_Click" />
                                    </StackPanel>

                                    <!-- File source -->
                                    <Grid x:Name="FileSourcePanel">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
                                            <TextBlock Text="Shellcode .bin path" Style="{StaticResource SectionSubtitleText}" VerticalAlignment="Center" />
                                            <Border x:Name="FileByteCountBadge" Style="{StaticResource ChipOkBorder}" Visibility="Collapsed">
                                                <TextBlock x:Name="FileByteCountText" Style="{StaticResource ChipMonoText}" Foreground="{StaticResource OkBrush}" />
                                            </Border>
                                            <Border x:Name="FileMissingBadge" Style="{StaticResource ChipErrBorder}" Visibility="Collapsed">
                                                <TextBlock Text="file not found" Style="{StaticResource ChipText}" Foreground="{StaticResource ErrBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="shellcodeFileInput"
                                                     FontFamily="{StaticResource MonoFontFamily}"
                                                     PlaceholderText="C:\Users\you\payloads\calc_x64.bin"
                                                     Margin="0,0,8,0" />
                                            <Button x:Name="browseShellcodeFileButton" Grid.Column="1" Content="Browse…" MinWidth="84" Click="BrowseShellcodeFile_Click" />
                                        </Grid>

                                        <!-- PE strip options — shown only when .exe is selected -->
                                        <Grid x:Name="PeStripOptionsPanel" Grid.Row="2" Visibility="Collapsed" Margin="0,12,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition x:Name="peStripSectionRow" Height="0" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <TextBlock Text="Strip mode" Style="{StaticResource SectionSubtitleText}" VerticalAlignment="Center" />
                                                <ComboBox x:Name="peStripModeCombo" MinWidth="200"
                                                          SelectedValuePath="Tag"
                                                          SelectionChanged="PeStripMode_SelectionChanged">
                                                    <ComboBoxItem Content="Entry point to end" Tag="ep" IsSelected="True" />
                                                    <ComboBoxItem Content="Named section" Tag="section" />
                                                </ComboBox>
                                                <CheckBox x:Name="peStripTrimCheck" Content="Trim trailing zeros" IsChecked="True" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
                                                <TextBlock Text="Section name" Style="{StaticResource SectionSubtitleText}" Width="110" VerticalAlignment="Center" />
                                                <TextBox x:Name="peStripSectionInput" PlaceholderText=".text" MinWidth="160"
                                                         FontFamily="{StaticResource MonoFontFamily}" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="2" Spacing="6" Margin="0,10,0,0">
                                                <Button Content="Analyze PE" Click="AnalyzePe_Click" />
                                                <TextBlock TextWrapping="Wrap" MaxWidth="520" FontSize="11"
                                                           Foreground="{StaticResource WarnBrush}"
                                                           Text="Only use .exe files that are shellcode-format PEs (e.g. produced by donut, pe2shellcode or sRDI). Standard Metasploit/Cobalt Strike EXEs require raw shellcode (.bin) instead." />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Donut options -->
                                        <Grid x:Name="DonutOptionsPanel" Grid.Row="3" Visibility="Collapsed" Margin="0,12,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <TextBlock Text="Target arch" Style="{StaticResource SectionSubtitleText}" VerticalAlignment="Center" />
                                                <ComboBox x:Name="donutArchCombo" MinWidth="140"
                                                          SelectedValuePath="Tag">
                                                    <ComboBoxItem Content="x86" Tag="1" />
                                                    <ComboBoxItem Content="x64" Tag="2" />
                                                    <ComboBoxItem Content="x86 + x64" Tag="3" IsSelected="True" />
                                                </ComboBox>
                                                <Border Style="{StaticResource ChipAccBorder}">
                                                    <TextBlock Text=".NET → shellcode via donut" Style="{StaticResource ChipText}" Foreground="{StaticResource AccHiBrush}" />
                                                </Border>
                                            </StackPanel>
                                            <Grid Grid.Row="1" Margin="0,8,0,0" ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Class (optional)" Style="{StaticResource SectionSubtitleText}" />
                                                    <TextBox x:Name="donutClassInput"
                                                             PlaceholderText="e.g. MyApp.Program"
                                                             FontFamily="{StaticResource MonoFontFamily}"
                                                             Margin="0,4,0,0" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="Method (optional)" Style="{StaticResource SectionSubtitleText}" />
                                                    <TextBox x:Name="donutMethodInput"
                                                             PlaceholderText="e.g. Main"
                                                             FontFamily="{StaticResource MonoFontFamily}"
                                                             Margin="0,4,0,0" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Params (optional)" Style="{StaticResource SectionSubtitleText}" />
                                                    <TextBox x:Name="donutParamsInput"
                                                             PlaceholderText="comma-separated args"
                                                             FontFamily="{StaticResource MonoFontFamily}"
                                                             Margin="0,4,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Grid>

                                    <!-- Raw source -->
                                    <Grid x:Name="RawSourcePanel" Visibility="Collapsed">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,6">
                                            <TextBlock Text="Raw shellcode" Style="{StaticResource SectionSubtitleText}" VerticalAlignment="Center" />
                                            <FontIcon Glyph="&#xE946;" FontSize="13" VerticalAlignment="Center"
                                                      Foreground="{StaticResource AccBrush}"
                                                      Tapped="RAWShellcodeInfo_Click"
                                                      ToolTipService.ToolTip="Click for shellcode format details" />
                                        </StackPanel>
                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="shellcodeRawInput"
                                                     FontFamily="{StaticResource MonoFontFamily}"
                                                     AcceptsReturn="True"
                                                     TextWrapping="NoWrap"
                                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                     MinHeight="160"
                                                     Margin="0,0,8,0" />
                                            <Button x:Name="pasteShellcodeButton" Grid.Column="1" Content="Paste" MinWidth="80" VerticalAlignment="Bottom" Click="PasteShellcode_Click" />
                                        </Grid>
                                    </Grid>

                                    <!-- URL source -->
                                    <Grid x:Name="UrlSourcePanel" Visibility="Collapsed">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Select a shellcode .bin file, then launch the wizard to configure web delivery."
                                                   Style="{StaticResource SectionSubtitleText}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,8" />
                                        <Grid Grid.Row="1" Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="shellcodeUrlFileInput"
                                                     PlaceholderText="Path to .bin shellcode file"
                                                     FontFamily="{StaticResource MonoFontFamily}"
                                                     Margin="0,0,8,0" />
                                            <Button x:Name="urlBrowseButton" Grid.Column="1" Content="Browse" MinWidth="84" Click="urlBrowseButton_Click" />
                                        </Grid>
                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="startWizardButton"
                                                    Content="Start wizard"
                                                    MinWidth="140"
                                                    Style="{StaticResource AccentButtonStyle}"
                                                    Click="StartWizard_Click" />
                                            <TextBlock x:Name="wizardStatusText" Grid.Column="1"
                                                       VerticalAlignment="Center" Margin="14,0,0,0"
                                                       Style="{StaticResource SectionSubtitleText}"
                                                       TextWrapping="Wrap" />
                                            <TextBox x:Name="shellcodeUrlValue" Visibility="Collapsed" />
                                        </Grid>
                                    </Grid>

                                    <!-- Generic source -->
                                    <Grid x:Name="GenericSourcePanel" Visibility="Collapsed">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Built-in test payloads"
                                                   Style="{StaticResource SectionSubtitleText}"
                                                   Margin="0,0,0,6" />
                                        <ComboBox x:Name="genericShellcodeCombo" Grid.Row="1" MinWidth="380" />
                                    </Grid>

                                    <!-- Action buttons -->
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                        <Button Content="Recompute hash" Click="ChangeShellcodeSource_Click" Visibility="Collapsed" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Right: detected analysis (visual fidelity) -->
                                <Border Grid.Column="1"
                                        BorderBrush="{StaticResource N4Brush}"
                                        BorderThickness="1,0,0,0"
                                        Padding="18,0,0,0">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="DETECTED" Style="{StaticResource SectionLabelText}" />
                                        <Grid ColumnSpacing="10" RowSpacing="3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="size" Style="{StaticResource MonoTinyText}" />
                                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="DetectedSizeText"
                                                       Text="—"
                                                       Style="{StaticResource MonoBodyText}"
                                                       Foreground="{StaticResource N10Brush}" />
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="arch" Style="{StaticResource MonoTinyText}" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DetectedArchText"
                                                       Text="—"
                                                       Style="{StaticResource MonoBodyText}"
                                                       Foreground="{StaticResource N10Brush}" />
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="entropy" Style="{StaticResource MonoTinyText}" />
                                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="DetectedEntropyText"
                                                       Text="—"
                                                       Style="{StaticResource MonoBodyText}"
                                                       Foreground="{StaticResource N10Brush}" />
                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="sha256" Style="{StaticResource MonoTinyText}" />
                                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="DetectedShaText"
                                                       Text="—"
                                                       Style="{StaticResource MonoBodyText}"
                                                       Foreground="{StaticResource N9Brush}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- ═══ Section: Shikata Ga Nai ═══ -->
                <StackPanel Spacing="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock Text="SHIKATA GA NAI · PREPROCESSOR" Style="{StaticResource SectionLabelText}" />
                            <Border Style="{StaticResource ChipAccBorder}">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <Ellipse Width="6" Height="6" Fill="{StaticResource AccBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="optional" Style="{StaticResource ChipText}" Foreground="{StaticResource AccHiBrush}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                    <Border x:Name="ShikataGaNaiExpander" Style="{StaticResource CardBorder}">
                        <StackPanel Spacing="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Polymorphic pre-encoding"
                                               Style="{StaticResource SectionTitleText}" />
                                    <TextBlock Text="Applied before the envelope/encoder stage."
                                               Style="{StaticResource SectionSubtitleText}"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                                <CheckBox Grid.Column="1"
                                          x:Name="shikataGaNaiEnabledCheckBox"
                                          Content="Enabled"
                                          Checked="ShikataGaNaiEnabledChanged"
                                          Unchecked="ShikataGaNaiEnabledChanged" />
                            </Grid>

                            <Border Style="{StaticResource SectionDivider}" />

                            <StackPanel Spacing="6">
                                <TextBlock Text="Placement" Style="{StaticResource SectionSubtitleText}" />
                                <RadioButton x:Name="shikataPlacementPre"
                                             GroupName="SgnPlacement"
                                             Content="Pre-Bin2Shell — bake SGN into the loader's shellcode (needs RWX at execution)"
                                             IsChecked="True"
                                             Checked="ShikataGaNaiPlacementChanged" />
                                <RadioButton x:Name="shikataPlacementPost"
                                             GroupName="SgnPlacement"
                                             Content="Post-Bin2Shell — emit an extra SGN-encoded .bin from the stripped loader (any execution method works)"
                                             Checked="ShikataGaNaiPlacementChanged" />
                            </StackPanel>

                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Encode count" Style="{StaticResource SectionSubtitleText}" />
                                    <NumberBox x:Name="shikataGaNaiEncodeCountInput"
                                               Value="1"
                                               Minimum="1"
                                               SmallChange="1"
                                               SpinButtonPlacementMode="Inline"
                                               IsEnabled="False" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="Max obfuscation bytes" Style="{StaticResource SectionSubtitleText}" />
                                    <NumberBox x:Name="shikataGaNaiMaxBytesInput"
                                               Value="50"
                                               Minimum="1"
                                               SmallChange="1"
                                               SpinButtonPlacementMode="Inline"
                                               IsEnabled="False" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ═══ Section: Payload Encoding ═══ -->
                <StackPanel x:Name="PayloadEncodingExpander" Spacing="12">
                    <TextBlock Text="ENCODING" Style="{StaticResource SectionLabelText}" />
                    <Border Style="{StaticResource CardBorder}">
                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="6">
                                <TextBlock Text="Encoder" Style="{StaticResource SectionSubtitleText}" />
                                <ComboBox x:Name="encoderCombo"
                                          HorizontalAlignment="Stretch"
                                          SelectionChanged="Encoder_SelectionChanged" />
                                <TextBlock x:Name="encoderDescriptionText"
                                           TextWrapping="Wrap"
                                           Style="{StaticResource SectionSubtitleText}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Text="Envelope" Style="{StaticResource SectionSubtitleText}" />
                                <ComboBox x:Name="envelopeCombo"
                                          HorizontalAlignment="Stretch"
                                          SelectionChanged="Envelope_SelectionChanged" />
                                <TextBlock x:Name="envelopeDescriptionText"
                                           TextWrapping="Wrap"
                                           Style="{StaticResource SectionSubtitleText}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- ═══ Section: Template ═══ -->
                <StackPanel Spacing="12">
                    <TextBlock Text="TEMPLATE &amp; PLAYBOOK" Style="{StaticResource SectionLabelText}" />
                    <Border Style="{StaticResource CardBorder}">
                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="6">
                                <TextBlock Text="Playbook" Style="{StaticResource SectionSubtitleText}" />
                                <ComboBox x:Name="playbookComboBox"
                                          HorizontalAlignment="Stretch"
                                          SelectionChanged="Playbook_SelectionChanged" />
                                <TextBlock x:Name="playbookPathText"
                                           Foreground="{StaticResource N7Brush}"
                                           FontFamily="{StaticResource MonoFontFamily}"
                                           FontSize="11"
                                           TextWrapping="WrapWholeWords" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Text="Template" Style="{StaticResource SectionSubtitleText}" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="templateCombo"
                                              Grid.Column="0"
                                              HorizontalAlignment="Stretch"
                                              SelectionChanged="Template_SelectionChanged" />
                                    <Button x:Name="configureTemplateButton"
                                            Grid.Column="1"
                                            Content="Configure"
                                            Click="ConfigureTemplate_Click"
                                            Style="{StaticResource AccentButtonStyle}" />
                                    <Button x:Name="refreshTemplateButton"
                                            Grid.Column="2"
                                            Content="Refresh"
                                            Click="refreshTemplateButton_Click" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- ═══ Next step card ═══ -->
                <Border Style="{StaticResource AccentTintBorder}" Padding="18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE72A;" FontSize="18" Margin="0,2,14,0" Foreground="{StaticResource AccHiBrush}" />
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="Next · Backdooring" Style="{StaticResource SectionTitleText}" Foreground="{StaticResource N10Brush}" />
                            <TextBlock Text="Continue to configure PE injection target, or skip to Compile."
                                       Style="{StaticResource SectionSubtitleText}" />
                        </StackPanel>
                        <Button x:Name="goToBackdooringButton"
                                Grid.Column="2"
                                Content="Configure Backdooring →"
                                MinWidth="200"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="GoToBackdooringPage_Click" />
                    </Grid>
                </Border>

                <!-- ═══ Status log (collapsible) ═══ -->
                <StackPanel Spacing="10">
                    <TextBlock Text="STATUS LOG" Style="{StaticResource SectionLabelText}" />
                    <Border Style="{StaticResource CardBorder}" Padding="2">
                        <RichEditBox x:Name="statusLogBox"
                                     Height="160"
                                     IsReadOnly="True"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontFamily="{StaticResource MonoFontFamily}"
                                     FontSize="12"
                                     FlowDirection="LeftToRight" />
                    </Border>
                </StackPanel>

                <!-- Disclaimer -->
                <Border Style="{StaticResource FlatCardBorder}" Padding="14">
                    <TextBlock Text="{x:Bind local:UiStrings.DisclaimerText}"
                               Style="{StaticResource PageSubtitleText}"
                               TextWrapping="Wrap" />
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
