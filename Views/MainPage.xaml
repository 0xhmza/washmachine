<Page x:Class="Washmachine.Views.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Washmachine"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      NavigationCacheMode="Required"
      >

    <Grid x:Name="Root" Background="Transparent">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,32,0,0">
            <StackPanel Margin="{StaticResource PageMargin}" Orientation="Vertical">

                <!-- Page header -->
                <StackPanel Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <FontIcon Glyph="&#xE80F;" FontSize="11" Margin="0,2,4,0" VerticalAlignment="Center"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="Home" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text=" › " FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Main" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE80F;" FontSize="22" Margin="0,2,12,0" />
                        <StackPanel>
                            <TextBlock Text="Loader Builder" Style="{StaticResource PageTitleText}" />
                            <TextBlock Text="Configure the build settings and compile your loader."
                                       Style="{StaticResource PageSubtitleText}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <Border Style="{StaticResource SectionDivider}" />

                <!-- Shellcode section -->
                <Expander IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,0,4">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <FontIcon Glyph="&#xE943;" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Shellcode" Style="{StaticResource SectionTitleText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Margin="0,12,0,4">
                        <TextBlock Text="Choose the shellcode source to embed in the build."
                                   Style="{StaticResource SectionSubtitleText}"
                                   Margin="0,0,0,12" />

                        <!-- Source picker (hidden once source selected) -->
                        <StackPanel x:Name="ShellcodeSourcePicker" Margin="0,4,0,12">
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel Margin="16">
                                    <TextBlock Text="Select a source" Style="{StaticResource SectionTitleText}" />
                                    <TextBlock Text="Pick exactly one source. You can change it later."
                                               Style="{StaticResource SectionSubtitleText}"
                                               Margin="0,4,0,12" />
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Row="0" Grid.Column="0" Margin="0,0,8,8"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                Tag="File" Click="ShellcodeSourceSelect_Click" Padding="12,10">
                                            <StackPanel Orientation="Horizontal">
                                                <FontIcon Glyph="&#xE8A5;" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                <TextBlock Text="From file" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <Button Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                Tag="Raw" Click="ShellcodeSourceSelect_Click" Padding="12,10">
                                            <StackPanel Orientation="Horizontal">
                                                <FontIcon Glyph="&#xE943;" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Raw bytes" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <Button Grid.Row="1" Grid.Column="0" Margin="0,0,8,0"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                Tag="Url" Click="ShellcodeSourceSelect_Click" Padding="12,10">
                                            <StackPanel Orientation="Horizontal">
                                                <FontIcon Glyph="&#xE71B;" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                <TextBlock Text="From URL" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <Button Grid.Row="1" Grid.Column="1"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                Tag="Generic" Click="ShellcodeSourceSelect_Click" Padding="12,10">
                                            <StackPanel Orientation="Horizontal">
                                                <FontIcon Glyph="&#xE7B8;" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Generic" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Source details (shown once source selected) -->
                        <StackPanel x:Name="ShellcodeSourceDetails" Visibility="Collapsed">
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8">
                                <Grid Margin="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon x:Name="ShellcodeSourceIcon" Glyph="&#xE943;" FontSize="20" Margin="0,2,12,0" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock x:Name="ShellcodeSourceTitle" Text="Selected source" Style="{StaticResource SectionTitleText}" />
                                        <TextBlock x:Name="ShellcodeSourceSummary" Text="Selected source: None"
                                                   Style="{StaticResource SectionSubtitleText}"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="Change source"
                                            Click="ChangeShellcodeSource_Click" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8">
                                <Grid Margin="12">
                                    <!-- File source -->
                                    <Grid x:Name="FileSourcePanel">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Shellcode file (.bin):" Margin="0,0,0,6" />
                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="shellcodeFile" Margin="0,0,8,0" />
                                            <Button x:Name="button1" Grid.Column="1" Content="Browse" MinWidth="72" Click="button1_Click" />
                                        </Grid>
                                    </Grid>

                                    <!-- Raw source -->
                                    <Grid x:Name="RawSourcePanel" Visibility="Collapsed">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="Raw shellcode:" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <FontIcon Glyph="&#xE946;" FontSize="14" VerticalAlignment="Center"
                                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                      Tapped="RAWShellcodeInfo_Click"
                                                      ToolTipService.ToolTip="Click for shellcode format details" />
                                        </StackPanel>
                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="shellcodeRAW"
                                                     FontFamily="Consolas"
                                                     AcceptsReturn="True"
                                                     TextWrapping="NoWrap"
                                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                     MinHeight="140"
                                                     Margin="0,0,8,0" />
                                            <Button x:Name="button2" Grid.Column="1" Content="Paste" MinWidth="72" VerticalAlignment="Bottom" Click="button2_Click" />
                                        </Grid>
                                    </Grid>

                                    <!-- URL source -->
                                    <Grid x:Name="UrlSourcePanel" Visibility="Collapsed">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Select a shellcode .bin file, then launch the wizard to configure web delivery." Margin="0,0,0,6" />
                                        <Grid Grid.Row="1" Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="shellcodeURLFile" PlaceholderText="Path to .bin shellcode file" Margin="0,0,8,0" />
                                            <Button x:Name="urlBrowseButton" Grid.Column="1" Content="Browse" MinWidth="72" Click="urlBrowseButton_Click" />
                                        </Grid>
                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="startWizardButton" Content="Start Wizard" MinWidth="120"
                                                    Style="{StaticResource AccentButtonStyle}"
                                                    Click="StartWizard_Click" />
                                            <TextBlock x:Name="wizardStatusText" Grid.Column="1"
                                                       VerticalAlignment="Center" Margin="12,0,0,0"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextWrapping="Wrap" FontSize="12" />
                                            <TextBox x:Name="shellcodeURL" Visibility="Collapsed" />
                                        </Grid>
                                    </Grid>

                                    <!-- Generic source -->
                                    <Grid x:Name="GenericSourcePanel" Visibility="Collapsed">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Choose a generic shellcode (for testing purposes):" Margin="0,0,0,6" />
                                        <ComboBox x:Name="genericShellcodeComboBox" Grid.Row="1" Width="360" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Expander>

                <Border Style="{StaticResource SectionDivider}" />

                <!-- Payload Encoding section -->
                <Expander x:Name="PayloadEncodingExpander" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,0,4">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <FontIcon Glyph="&#xE809;" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Payload Encoding" Style="{StaticResource SectionTitleText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Expander.Header>
                    <Grid Margin="0,12,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Encoder:" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox x:Name="bin2hexEncoder" Grid.Column="1" Margin="0,0,16,0" />
                        <TextBlock Grid.Column="2" Text="Envelope:" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox x:Name="bin2hexEnvelope" Grid.Column="3" />
                    </Grid>
                </Expander>

                <Border Style="{StaticResource SectionDivider}" />

                <!-- Template section -->
                <Expander IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,0,4">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <FontIcon Glyph="&#xE8A5;" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Template" Style="{StaticResource SectionTitleText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Margin="0,12,0,4">

                        <TextBlock Text="Select a template:"
                                   Style="{StaticResource SectionSubtitleText}"
                                   Margin="0,0,0,6" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="templateComboBox" Margin="0,0,8,0" SelectionChanged="templateComboBox_SelectedIndexChanged" />
                            <Button x:Name="button4" Grid.Column="1" Content="Configure" MinWidth="110" Margin="0,0,8,0" Click="button4_Click" />
                            <Button x:Name="refreshTemplateButton" Grid.Column="2" Content="Refresh" MinWidth="90" Click="refreshTemplateButton_Click" />
                        </Grid>

                        <TextBlock x:Name="templateCatalogPath"
                                   Style="{StaticResource PageSubtitleText}"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Expander>

                <Border Style="{StaticResource SectionDivider}" />

                <!-- Compile card -->
                <Border Style="{StaticResource CardBorder}" Margin="0">
                    <StackPanel Margin="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE90F;" FontSize="20" Margin="0,2,12,0" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Compile" Style="{StaticResource SectionTitleText}" />
                                <TextBlock Text="Build the loader with the selected settings."
                                           Style="{StaticResource SectionSubtitleText}"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                            <Button x:Name="submitButton"
                                    Grid.Column="2"
                                    Content="Compile"
                                    Width="140"
                                    Margin="16,0,0,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Click="submitButton_Click" />
                        </Grid>
                        <StackPanel x:Name="compileStatusPanel" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed">
                            <FontIcon x:Name="compileStatusIcon" Glyph="&#xE73E;" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="compileStatusText" VerticalAlignment="Center" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <HyperlinkButton x:Name="compileOutputLink" Padding="4,0" VerticalAlignment="Center"
                                             FontSize="12" Visibility="Collapsed" Click="CompileOutputLink_Click">
                                <TextBlock x:Name="compileOutputLinkText" TextDecorations="Underline" FontSize="12" />
                            </HyperlinkButton>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionDivider}" />

                <!-- Logs section -->
                <Expander IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,0,4">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <FontIcon Glyph="&#xF0E3;" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Logs" Style="{StaticResource SectionTitleText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Expander.Header>
                    <RichEditBox x:Name="debugBox"
                                 Height="170"
                                 IsReadOnly="True"
                                 FontFamily="Consolas"
                                 FontSize="13"
                                 FlowDirection="LeftToRight"
                                 Margin="0,8,0,0" />
                </Expander>

                <Border Style="{StaticResource SectionDivider}" />

                <!-- Disclaimer -->
                <Border Style="{StaticResource CardBorder}" Margin="0">
                    <Grid Margin="12">
                        <TextBlock Text="{x:Bind local:UiStrings.DisclaimerText}"
                                   Style="{StaticResource PageSubtitleText}"
                                   TextWrapping="Wrap" />
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
