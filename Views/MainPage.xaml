<Page x:Class="Washmachine.Views.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Washmachine"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      NavigationCacheMode="Required"
      >

    <Grid x:Name="Root" Background="Transparent">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,32,0,0">
            <StackPanel Margin="{StaticResource PageMargin}"
                        Orientation="Vertical"
                        Width="{StaticResource ContentMaxWidth}"
                        HorizontalAlignment="Center">

                <!-- Page header -->
                <StackPanel Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <FontIcon Glyph="&#xE80F;" FontSize="11" Margin="0,2,4,0" VerticalAlignment="Center"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="Pipeline" Margin="2,0,0,0" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text=" › " Margin="0,0,5,0" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Payload" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Margin="0,20,0,20" Orientation="Horizontal" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE943;" FontSize="30" Margin="0,2,12,0" />
                        <StackPanel>
                            <TextBlock Text="Payload Configuration" Style="{StaticResource PageTitleText}" />
                            <TextBlock Text="Configure shellcode source, encoding, and loader template."
                                       Style="{StaticResource PageSubtitleText}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </StackPanel>
                    
                </StackPanel>


                <!-- Shellcode section -->
                <Expander IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,0,4">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <FontIcon Glyph="&#xE943;" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Shellcode" Style="{StaticResource SectionTitleText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Margin="0,12,0,4">
                        <TextBlock Text="Choose the shellcode source to embed in the build."
                                   Style="{StaticResource SectionSubtitleText}"
                                   Margin="0,0,0,12" />

                        <!-- Source picker (hidden once source selected) -->
                        <StackPanel x:Name="ShellcodeSourcePicker" Margin="0,4,0,12">
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel Margin="16">
                                    <TextBlock Text="Select a source" Style="{StaticResource SectionTitleText}" />
                                    <TextBlock Text="Pick exactly one source. You can change it later."
                                               Style="{StaticResource SectionSubtitleText}"
                                               Margin="0,4,0,12" />
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Row="0" Grid.Column="0" Margin="0,0,8,8"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                Tag="File" Click="ShellcodeSourceSelect_Click" Padding="12,10">
                                            <StackPanel Orientation="Horizontal">
                                                <FontIcon Glyph="&#xE8A5;" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                <TextBlock Text="From file" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <Button Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                Tag="Raw" Click="ShellcodeSourceSelect_Click" Padding="12,10">
                                            <StackPanel Orientation="Horizontal">
                                                <FontIcon Glyph="&#xE943;" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Raw bytes" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <Button Grid.Row="1" Grid.Column="0" Margin="0,0,8,0"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                Tag="Url" Click="ShellcodeSourceSelect_Click" Padding="12,10">
                                            <StackPanel Orientation="Horizontal">
                                                <FontIcon Glyph="&#xE71B;" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                <TextBlock Text="From URL" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <Button Grid.Row="1" Grid.Column="1"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                Tag="Generic" Click="ShellcodeSourceSelect_Click" Padding="12,10">
                                            <StackPanel Orientation="Horizontal">
                                                <FontIcon Glyph="&#xE7B8;" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Generic" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Source details (shown once source selected) -->
                        <StackPanel x:Name="ShellcodeSourceDetails" Visibility="Collapsed">
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8">
                                <Grid Margin="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon x:Name="ShellcodeSourceIcon" Glyph="&#xE943;" FontSize="20" Margin="0,2,12,0" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock x:Name="ShellcodeSourceTitle" Text="Selected source" Style="{StaticResource SectionTitleText}" />
                                        <TextBlock x:Name="ShellcodeSourceSummary" Text="Selected source: None"
                                                   Style="{StaticResource SectionSubtitleText}"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="Change source"
                                            Click="ChangeShellcodeSource_Click" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8">
                                <Grid Margin="12">
                                    <!-- File source -->
                                    <Grid x:Name="FileSourcePanel">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
                                            <TextBlock Text="Shellcode file (.bin):" VerticalAlignment="Center" />
                                            <Border x:Name="FileByteCountBadge" Visibility="Collapsed"
                                                    Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                                    CornerRadius="10" Padding="6,2">
                                                <TextBlock x:Name="FileByteCountText" FontSize="11" FontFamily="Consolas" />
                                            </Border>
                                            <Border x:Name="FileMissingBadge" Visibility="Collapsed"
                                                    Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                                                    CornerRadius="10" Padding="6,2">
                                                <TextBlock Text="file not found" FontSize="11" />
                                            </Border>
                                        </StackPanel>
                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="shellcodeFileInput" Margin="0,0,8,0" />
                                            <Button x:Name="browseShellcodeFileButton" Grid.Column="1" Content="Browse" MinWidth="72" Click="BrowseShellcodeFile_Click" />
                                        </Grid>
                                    </Grid>

                                    <!-- Raw source -->
                                    <Grid x:Name="RawSourcePanel" Visibility="Collapsed">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="Raw shellcode:" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <FontIcon Glyph="&#xE946;" FontSize="14" VerticalAlignment="Center"
                                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                      Tapped="RAWShellcodeInfo_Click"
                                                      ToolTipService.ToolTip="Click for shellcode format details" />
                                        </StackPanel>
                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="shellcodeRawInput"
                                                     FontFamily="Consolas"
                                                     AcceptsReturn="True"
                                                     TextWrapping="NoWrap"
                                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                     MinHeight="140"
                                                     Margin="0,0,8,0" />
                                            <Button x:Name="pasteShellcodeButton" Grid.Column="1" Content="Paste" MinWidth="72" VerticalAlignment="Bottom" Click="PasteShellcode_Click" />
                                        </Grid>
                                    </Grid>

                                    <!-- URL source -->
                                    <Grid x:Name="UrlSourcePanel" Visibility="Collapsed">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Select a shellcode .bin file, then launch the wizard to configure web delivery." Margin="0,0,0,6" />
                                        <Grid Grid.Row="1" Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="shellcodeUrlFileInput" PlaceholderText="Path to .bin shellcode file" Margin="0,0,8,0" />
                                            <Button x:Name="urlBrowseButton" Grid.Column="1" Content="Browse" MinWidth="72" Click="urlBrowseButton_Click" />
                                        </Grid>
                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="startWizardButton" Content="Start Wizard" MinWidth="120"
                                                    Style="{StaticResource AccentButtonStyle}"
                                                    Click="StartWizard_Click" />
                                            <TextBlock x:Name="wizardStatusText" Grid.Column="1"
                                                       VerticalAlignment="Center" Margin="12,0,0,0"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextWrapping="Wrap" FontSize="12" />
                                            <TextBox x:Name="shellcodeUrlValue" Visibility="Collapsed" />
                                        </Grid>
                                    </Grid>

                                    <!-- Generic source -->
                                    <Grid x:Name="GenericSourcePanel" Visibility="Collapsed">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Choose a generic shellcode (for testing purposes):" Margin="0,0,0,6" />
                                        <ComboBox x:Name="genericShellcodeCombo" Grid.Row="1" Width="360" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Expander>

                <Border Margin="10,10,10,10"/>

                <!-- Shikata Ga Nai section (runs before Payload Encoding when enabled) -->
                <Expander x:Name="ShikataGaNaiExpander" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,0,4">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <FontIcon Glyph="&#xE8C8;" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Shikata Ga Nai" Style="{StaticResource SectionTitleText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Margin="0,12,0,4" Spacing="12">
                        <TextBlock Text="Polymorphic pre-encoding applied before the envelope/encoder stage."
                                   Style="{StaticResource SectionSubtitleText}" />
                        <CheckBox x:Name="shikataGaNaiEnabledCheckBox"
                                  Content="Enable Shikata Ga Nai encoding"
                                  Checked="ShikataGaNaiEnabledChanged"
                                  Unchecked="ShikataGaNaiEnabledChanged" />

                        <StackPanel Spacing="6">
                            <TextBlock Text="Placement" Style="{StaticResource SectionSubtitleText}" />
                            <RadioButton x:Name="shikataPlacementPre"
                                         GroupName="SgnPlacement"
                                         Content="Pre-Bin2Shell — bake SGN into the loader's shellcode (needs RWX at execution)"
                                         IsChecked="True"
                                         Checked="ShikataGaNaiPlacementChanged" />
                            <RadioButton x:Name="shikataPlacementPost"
                                         GroupName="SgnPlacement"
                                         Content="Post-Bin2Shell — emit an extra SGN-encoded .bin from the stripped loader (any execution method works)"
                                         Checked="ShikataGaNaiPlacementChanged" />
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,8,0">
                                <TextBlock Text="Encode count" Style="{StaticResource SectionSubtitleText}" />
                                <NumberBox x:Name="shikataGaNaiEncodeCountInput"
                                           Value="1"
                                           Minimum="1"
                                           SmallChange="1"
                                           SpinButtonPlacementMode="Inline"
                                           IsEnabled="False" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4" Margin="8,0,0,0">
                                <TextBlock Text="Max obfuscation bytes" Style="{StaticResource SectionSubtitleText}" />
                                <NumberBox x:Name="shikataGaNaiMaxBytesInput"
                                           Value="50"
                                           Minimum="1"
                                           SmallChange="1"
                                           SpinButtonPlacementMode="Inline"
                                           IsEnabled="False" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Expander>

                <!-- Payload Encoding section -->
                <Expander x:Name="PayloadEncodingExpander" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,0,4">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <FontIcon Glyph="&#xE809;" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Payload Encoding" Style="{StaticResource SectionTitleText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Margin="0,12,0,4" Spacing="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,8,0">
                                <TextBlock Text="Encoder" Style="{StaticResource SectionSubtitleText}" />
                                <ComboBox x:Name="encoderCombo"
                                          HorizontalAlignment="Stretch"
                                          SelectionChanged="Encoder_SelectionChanged" />
                                <TextBlock x:Name="encoderDescriptionText"
                                           TextWrapping="Wrap"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4" Margin="8,0,0,0">
                                <TextBlock Text="Envelope" Style="{StaticResource SectionSubtitleText}" />
                                <ComboBox x:Name="envelopeCombo"
                                          HorizontalAlignment="Stretch"
                                          SelectionChanged="Envelope_SelectionChanged" />
                                <TextBlock x:Name="envelopeDescriptionText"
                                           TextWrapping="Wrap"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Expander>

                <!-- Template section -->
                <Expander IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <FontIcon Glyph="&#xE8A5;" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Payload Features" Style="{StaticResource SectionTitleText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Expander.Header>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Playbook Column -->
                        <StackPanel Grid.Column="0" Spacing="6">
                            <TextBlock Text="Playbook"
                       Style="{StaticResource SectionSubtitleText}" />
                            <ComboBox x:Name="playbookComboBox"
                      HorizontalAlignment="Stretch"
                      SelectionChanged="Playbook_SelectionChanged" />
                            <TextBlock x:Name="playbookPathText"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="WrapWholeWords"
                       Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>

                        <!-- Template Column -->
                        <StackPanel Grid.Column="2" Spacing="6">
                            <TextBlock Text="Template"
                       Style="{StaticResource SectionSubtitleText}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ComboBox x:Name="templateCombo"
                          Grid.Column="0"
                          HorizontalAlignment="Stretch"
                          Margin="0,0,8,0"
                          SelectionChanged="Template_SelectionChanged" />

                                <Button x:Name="configureTemplateButton"
                        Grid.Column="1"
                        Content="Configure"
                        MinWidth="110"
                        Margin="0,0,8,0"
                        Click="ConfigureTemplate_Click"
                        Style="{StaticResource AccentButtonStyle}" />

                                <Button x:Name="refreshTemplateButton"
                        Grid.Column="2"
                        Content="Refresh"
                        MinWidth="90"
                        Click="refreshTemplateButton_Click" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Expander>


                <!-- Next Step card -->
                <Border Style="{StaticResource CardBorder}" Margin="0">
                    <StackPanel Margin="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE72A;" FontSize="20" Margin="0,2,12,0" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Next: Backdooring" Style="{StaticResource SectionTitleText}" />
                                <TextBlock Text="Continue to configure PE injection target, or skip to Compile."
                                           Style="{StaticResource SectionSubtitleText}"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                            <Button x:Name="goToBackdooringButton"
                                    Grid.Column="2"
                                    Content="Configure Backdooring →"
                                    Width="200"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Click="GoToBackdooringPage_Click" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Margin="10,10,10,30"/>
                <!-- Status section (read-only) -->
                <Expander IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,0,4">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <FontIcon Glyph="&#xF0E3;" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Status Log" Style="{StaticResource SectionTitleText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Expander.Header>
                    <RichEditBox x:Name="statusLogBox"
                                 Height="120"
                                 IsReadOnly="True"
                                 FontFamily="Consolas"
                                 FontSize="13"
                                 FlowDirection="LeftToRight"
                                 Margin="0,8,0,0" />
                </Expander>

                <Border Margin="10,10,10,10"/>
                <!-- Disclaimer -->
                <Border Style="{StaticResource CardBorder}" Margin="0">
                    <Grid Margin="12">
                        <TextBlock Text="{x:Bind local:UiStrings.DisclaimerText}"
                                   Style="{StaticResource PageSubtitleText}"
                                   TextWrapping="Wrap" />
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
