<Page x:Class="Washmachine.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      NavigationCacheMode="Enabled">

    <Grid Background="Transparent">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,32,0,0">
            <StackPanel Margin="{StaticResource PageMargin}"
                        Orientation="Vertical"
                        Width="{StaticResource ContentMaxWidth}"
                        HorizontalAlignment="Center">

                <!-- Page header -->
                <StackPanel Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <FontIcon Glyph="&#xE80F;" FontSize="11" Margin="0,2,4,0" VerticalAlignment="Center"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="Application" Margin="2,0,0,0" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text=" › " Margin="0,0,5,0" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Settings" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Margin="0,20,0,20" Orientation="Horizontal" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE713;" FontSize="30" Margin="0,2,12,0" />
                        <StackPanel>
                            <TextBlock Text="Settings" Style="{StaticResource PageTitleText}" />
                            <TextBlock Text="Manage templates and application preferences."
                                       Style="{StaticResource PageSubtitleText}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <Border Style="{StaticResource SectionDivider}" />

                <!-- Template Import -->
                <Expander x:Name="templateExpander"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch"
                          IsExpanded="True"
                          Margin="0,0,0,4">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <FontIcon Glyph="&#xE8B5;" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Template Import" Style="{StaticResource SectionTitleText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Margin="0,12,0,4" Spacing="12">
                        <TextBlock Text="Import a template catalog from a URL or local file."
                                   Style="{StaticResource SectionSubtitleText}" />

                        <StackPanel Spacing="4">
                            <TextBlock Text="Import from URL" Style="{StaticResource SectionSubtitleText}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="templateCatalogUrl"
                                         PlaceholderText="https://example.com/vx_api_snippets.yaml"
                                         Margin="0,0,8,0" />
                                <Button x:Name="importTemplateUrlButton"
                                        Grid.Column="1"
                                        Content="Import URL"
                                        MinWidth="110"
                                        Click="importTemplateUrlButton_Click" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="importTemplateFileButton"
                                    Content="Import file"
                                    MinWidth="110"
                                    Click="importTemplateFileButton_Click" />
                            <Button x:Name="openTemplateFolderButton"
                                    Content="Open templates folder"
                                    MinWidth="160"
                                    Click="openTemplateFolderButton_Click" />
                        </StackPanel>
                    </StackPanel>
                </Expander>

                <Border Style="{StaticResource SectionDivider}" />

                <!-- Build Artifacts -->
                <Expander x:Name="buildArtifactsExpander"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch"
                          IsExpanded="True"
                          Margin="0,0,0,4">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <FontIcon Glyph="&#xE74E;" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Build Artifacts" Style="{StaticResource SectionTitleText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Margin="0,12,0,4" Spacing="12">
                        <TextBlock Text="Compiled loader copies are written to temp/cpp/compiled/ during a build."
                                   Style="{StaticResource SectionSubtitleText}"
                                   TextWrapping="Wrap" />

                        <Border Style="{StaticResource CardBorder}">
                            <Grid Padding="20,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="4,0,16,0">
                                    <TextBlock Text="Keep build artifact copies" Style="{StaticResource SectionTitleText}" />
                                    <TextBlock Text="Off (default): wipe temp/cpp/ after every successful build so timestamp-named copies don't accumulate. On: retain the copies (forensic comparison, debugging)."
                                               Style="{StaticResource SectionSubtitleText}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                                <ToggleSwitch x:Name="toggleKeepBuildArtifacts"
                                              Grid.Column="1"
                                              OnContent="On" OffContent="Off"
                                              Toggled="toggleKeepBuildArtifacts_Toggled"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              MinWidth="0" Margin="8,0,8,0" Header="" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Expander>

                <Border Style="{StaticResource SectionDivider}" />

                <!-- Session Logging -->
                <Expander x:Name="loggingExpander"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch"
                          IsExpanded="True"
                          Margin="0,0,0,4">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <FontIcon Glyph="&#xE9D9;" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Session Logging" Style="{StaticResource SectionTitleText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Margin="0,12,0,4" Spacing="12">
                        <TextBlock Text="Control what gets saved when a backdoor operation runs."
                                   Style="{StaticResource SectionSubtitleText}" />

                        <Border Style="{StaticResource CardBorder}">
                            <Grid Padding="20,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="4,0,16,0">
                                    <TextBlock Text="Enable Session Logging" Style="{StaticResource SectionTitleText}" />
                                    <TextBlock Text="Automatically create a session log folder for each backdoor operation."
                                               Style="{StaticResource SectionSubtitleText}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                                <ToggleSwitch x:Name="toggleSessionLogging"
                                              Grid.Column="1"
                                              OnContent="On" OffContent="Off"
                                              Toggled="toggleSessionLogging_Toggled"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              MinWidth="0" Margin="8,0,8,0" Header="" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource CardBorder}">
                            <Grid Padding="20,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="4,0,16,0">
                                    <TextBlock Text="Save Binary Artifact" Style="{StaticResource SectionTitleText}" />
                                    <TextBlock Text="Copy the backdoored output binary into the session folder."
                                               Style="{StaticResource SectionSubtitleText}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                                <ToggleSwitch x:Name="toggleSaveBinary"
                                              Grid.Column="1"
                                              OnContent="On" OffContent="Off"
                                              Toggled="toggleSaveBinary_Toggled"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              MinWidth="0" Margin="8,0,8,0" Header="" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource CardBorder}">
                            <Grid Padding="20,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="4,0,16,0">
                                    <TextBlock Text="Save Shellcode Copy" Style="{StaticResource SectionTitleText}" />
                                    <TextBlock Text="Copy the original shellcode .bin into the session folder."
                                               Style="{StaticResource SectionSubtitleText}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                                <ToggleSwitch x:Name="toggleSaveShellcode"
                                              Grid.Column="1"
                                              OnContent="On" OffContent="Off"
                                              Toggled="toggleSaveShellcode_Toggled"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              MinWidth="0" Margin="8,0,8,0" Header="" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource CardBorder}">
                            <Grid Padding="20,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="4,0,16,0">
                                    <TextBlock Text="Verbose File Logging" Style="{StaticResource SectionTitleText}" />
                                    <TextBlock Text="Include debug-level messages in the session log file."
                                               Style="{StaticResource SectionSubtitleText}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                                <ToggleSwitch x:Name="toggleVerboseLogging"
                                              Grid.Column="1"
                                              OnContent="On" OffContent="Off"
                                              Toggled="toggleVerboseLogging_Toggled"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              MinWidth="0" Margin="8,0,8,0" Header="" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Expander>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
