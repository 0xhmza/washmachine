<Page x:Class="Washmachine.Views.PipelinePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      NavigationCacheMode="Required">

    <Page.Resources>
        <!-- Cinematic palette -->
        <Color x:Key="HudBgDeep">#FF050912</Color>
        <Color x:Key="HudBgMid">#FF0A1322</Color>
        <Color x:Key="HudBgPanel">#FF0E1A2E</Color>
        <Color x:Key="HudCyan">#FF00E0FF</Color>
        <Color x:Key="HudCyanSoft">#5500E0FF</Color>
        <Color x:Key="HudCyanGhost">#1A00E0FF</Color>
        <Color x:Key="HudAmber">#FFFFB347</Color>
        <Color x:Key="HudMint">#FF7CFFA8</Color>
        <Color x:Key="HudInk">#FFE6F1FF</Color>
        <Color x:Key="HudInkDim">#FF7A8CB0</Color>
        <Color x:Key="HudInkFaint">#FF42587A</Color>
        <Color x:Key="HudGridLine">#22418FBB</Color>

        <SolidColorBrush x:Key="HudCyanBrush" Color="{StaticResource HudCyan}" />
        <SolidColorBrush x:Key="HudCyanSoftBrush" Color="{StaticResource HudCyanSoft}" />
        <SolidColorBrush x:Key="HudCyanGhostBrush" Color="{StaticResource HudCyanGhost}" />
        <SolidColorBrush x:Key="HudAmberBrush" Color="{StaticResource HudAmber}" />
        <SolidColorBrush x:Key="HudMintBrush" Color="{StaticResource HudMint}" />
        <SolidColorBrush x:Key="HudInkBrush" Color="{StaticResource HudInk}" />
        <SolidColorBrush x:Key="HudInkDimBrush" Color="{StaticResource HudInkDim}" />
        <SolidColorBrush x:Key="HudInkFaintBrush" Color="{StaticResource HudInkFaint}" />
        <SolidColorBrush x:Key="HudPanelBrush" Color="{StaticResource HudBgPanel}" />
        <SolidColorBrush x:Key="HudGridLineBrush" Color="{StaticResource HudGridLine}" />

        <LinearGradientBrush x:Key="HudBackdropBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{StaticResource HudBgDeep}" Offset="0.0" />
            <GradientStop Color="{StaticResource HudBgMid}"  Offset="0.6" />
            <GradientStop Color="{StaticResource HudBgDeep}" Offset="1.0" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="HudHeaderBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FF0B1628" Offset="0.0" />
            <GradientStop Color="#FF050912" Offset="1.0" />
        </LinearGradientBrush>

        <Style x:Key="HudMonoText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource HudInkDimBrush}" />
        </Style>

        <Style x:Key="HudLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="CharacterSpacing" Value="200" />
            <Setter Property="Foreground" Value="{StaticResource HudInkFaintBrush}" />
        </Style>

        <Style x:Key="HudValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource HudInkBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="HudPanel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource HudPanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource HudCyanSoftBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Padding" Value="14" />
        </Style>
    </Page.Resources>

    <Grid Background="{StaticResource HudBackdropBrush}">
        <!-- Faint scan-line / grid texture (decorative) -->
        <Canvas x:Name="GridOverlay" IsHitTestVisible="False" Opacity="0.35" />

        <Grid Margin="22,18,22,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />   <!-- top status bar -->
                <RowDefinition Height="Auto" />   <!-- title block -->
                <RowDefinition Height="*" />      <!-- main content -->
                <RowDefinition Height="Auto" />   <!-- bottom telemetry strip -->
            </Grid.RowDefinitions>

            <!-- ═════════════════════════ TOP STATUS BAR ═════════════════════════ -->
            <Border Grid.Row="0"
                    Background="{StaticResource HudHeaderBrush}"
                    BorderBrush="{StaticResource HudCyanSoftBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="16,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusIndicatorDot"
                                 Width="9" Height="9"
                                 Fill="{StaticResource HudMintBrush}" />
                        <TextBlock x:Name="StatusIndicatorText"
                                   Text="◤ PIPELINE NOMINAL"
                                   Style="{StaticResource HudLabel}"
                                   Foreground="{StaticResource HudMintBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                HorizontalAlignment="Center" Spacing="22">
                        <TextBlock x:Name="HeaderBuildId"   Style="{StaticResource HudLabel}" Text="BUILD-ID ⋯⋯⋯⋯" />
                        <TextBlock x:Name="HeaderTimestamp" Style="{StaticResource HudLabel}" Text="UTC ⋯⋯⋯⋯⋯⋯" />
                        <TextBlock x:Name="HeaderTarget"    Style="{StaticResource HudLabel}" Text="TARGET ⋯⋯⋯⋯" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                        <Button x:Name="ImportRecipeButton"
                                Content="↑ Load recipe"
                                Click="ImportRecipe_Click"
                                Background="Transparent"
                                BorderBrush="{StaticResource HudCyanSoftBrush}"
                                Foreground="{StaticResource HudCyanBrush}"
                                FontFamily="Cascadia Mono, Consolas"
                                FontSize="11"
                                Padding="10,4" />
                        <Button x:Name="ExportRecipeButton"
                                Content="↓ Save recipe"
                                Click="ExportRecipe_Click"
                                Background="Transparent"
                                BorderBrush="{StaticResource HudCyanSoftBrush}"
                                Foreground="{StaticResource HudCyanBrush}"
                                FontFamily="Cascadia Mono, Consolas"
                                FontSize="11"
                                Padding="10,4" />
                        <Border Width="1" Background="{StaticResource HudCyanGhostBrush}" Margin="2,4" />
                        <Button x:Name="RefreshButton"
                                Content="↻ Re-sync"
                                Click="Refresh_Click"
                                Background="Transparent"
                                BorderBrush="{StaticResource HudCyanSoftBrush}"
                                Foreground="{StaticResource HudCyanBrush}"
                                FontFamily="Cascadia Mono, Consolas"
                                FontSize="11"
                                Padding="10,4" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═════════════════════════ TITLE BLOCK ═════════════════════════ -->
            <Grid Grid.Row="1" Margin="2,16,2,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="┌── BUILD PIPELINE ──┐"
                               FontFamily="Cascadia Mono, Consolas"
                               FontSize="11"
                               Foreground="{StaticResource HudCyanBrush}" />
                    <TextBlock Text="OPERATIONAL READOUT"
                               FontFamily="Cascadia Mono, Consolas"
                               FontSize="28"
                               FontWeight="SemiBold"
                               CharacterSpacing="120"
                               Foreground="{StaticResource HudInkBrush}"
                               Margin="0,2,0,0" />
                    <TextBlock x:Name="TitleSubline"
                               Style="{StaticResource HudMonoText}"
                               Margin="0,4,0,0"
                               Text="// live recipe — autoderived from Payload, Backdooring, Packing, Finalize, Compile" />
                </StackPanel>

                <!-- Pipeline integrity / count chip cluster -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                    <Border Background="{StaticResource HudCyanGhostBrush}"
                            BorderBrush="{StaticResource HudCyanSoftBrush}"
                            BorderThickness="1" CornerRadius="2" Padding="10,4">
                        <StackPanel>
                            <TextBlock x:Name="ChipStepsLabel" Style="{StaticResource HudLabel}" Text="STAGES" />
                            <TextBlock x:Name="ChipStepsValue" Style="{StaticResource HudValue}"
                                       Text="0" FontSize="16"
                                       Foreground="{StaticResource HudCyanBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource HudCyanGhostBrush}"
                            BorderBrush="{StaticResource HudCyanSoftBrush}"
                            BorderThickness="1" CornerRadius="2" Padding="10,4">
                        <StackPanel>
                            <TextBlock Style="{StaticResource HudLabel}" Text="ARTIFACTS" />
                            <TextBlock x:Name="ChipArtifactsValue" Style="{StaticResource HudValue}"
                                       Text="0" FontSize="16"
                                       Foreground="{StaticResource HudCyanBrush}" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="ChipWarningBorder"
                            Visibility="Collapsed"
                            Background="#22FFB347"
                            BorderBrush="{StaticResource HudAmberBrush}"
                            BorderThickness="1" CornerRadius="2" Padding="10,4">
                        <StackPanel>
                            <TextBlock Style="{StaticResource HudLabel}" Text="ALERTS" Foreground="{StaticResource HudAmberBrush}" />
                            <TextBlock x:Name="ChipWarningValue" Style="{StaticResource HudValue}"
                                       Text="0" FontSize="16"
                                       Foreground="{StaticResource HudAmberBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ═════════════════════════ MAIN CONTENT ═════════════════════════ -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />   <!-- step rail -->
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />    <!-- spec sidebar -->
                </Grid.ColumnDefinitions>

                <!-- ─── STEP RAIL (left) ─── -->
                <Border Grid.Column="0" Style="{StaticResource HudPanel}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Padding="14,10,14,8"
                              Background="#FF0A1525">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="◢"
                                           FontFamily="Segoe UI Symbol"
                                           Foreground="{StaticResource HudCyanBrush}" />
                                <TextBlock Text="STAGE TRANSPORT"
                                           Style="{StaticResource HudLabel}"
                                           Foreground="{StaticResource HudInkBrush}" />
                                <TextBlock x:Name="RailEtaText"
                                           Style="{StaticResource HudLabel}"
                                           Margin="14,0,0,0" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Style="{StaticResource HudLabel}"
                                       Text="// linear, top → bottom" />
                        </Grid>

                        <!-- Top alert banner (SGN/exec compatibility, etc) -->
                        <Border x:Name="AlertBanner"
                                Grid.Row="1" Margin="14,8,14,4"
                                Background="#22FFB347"
                                BorderBrush="{StaticResource HudAmberBrush}"
                                BorderThickness="1" CornerRadius="2"
                                Padding="12,8" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="⚠"
                                           Foreground="{StaticResource HudAmberBrush}"
                                           VerticalAlignment="Top" FontSize="14" />
                                <TextBlock x:Name="AlertBannerText"
                                           Style="{StaticResource HudMonoText}"
                                           Foreground="{StaticResource HudAmberBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <ScrollViewer Grid.Row="2"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="14,4,14,14">
                            <ItemsControl x:Name="StepsList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Vertical" Spacing="0" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- ─── SPEC SIDEBAR (right) ─── -->
                <ScrollViewer Grid.Column="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="10" x:Name="SpecPanelHost" />
                </ScrollViewer>
            </Grid>

            <!-- ═════════════════════════ BOTTOM TELEMETRY ═════════════════════════ -->
            <Border Grid.Row="3"
                    Background="#FF070D1A"
                    BorderBrush="{StaticResource HudCyanSoftBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="14,6"
                    Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TelemetryLine"
                               Style="{StaticResource HudMonoText}"
                               Foreground="{StaticResource HudInkDimBrush}"
                               Text="◦ awaiting sync ◦" />
                    <TextBlock Grid.Column="1"
                               Style="{StaticResource HudLabel}"
                               Foreground="{StaticResource HudInkFaintBrush}"
                               Text="WASHMACHINE // PIPELINE TELEMETRY v1" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
