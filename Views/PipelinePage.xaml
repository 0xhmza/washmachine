<Page x:Class="Washmachine.Views.PipelinePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      NavigationCacheMode="Required">

    <Page.Resources>
        <!-- Semantic brushes for code-built stage cards and spec panels.
             Defined here so code-behind can access via Resources["key"]. -->
        <SolidColorBrush x:Key="PipeAccentBrush"     Color="{ThemeResource SystemAccentColor}" />
        <SolidColorBrush x:Key="PipeWarnBrush"       Color="{ThemeResource SystemFillColorCaution}" />
        <SolidColorBrush x:Key="PipeSkipBrush"       Color="{ThemeResource TextFillColorDisabled}" />
        <SolidColorBrush x:Key="PipeTextDimBrush"    Color="{ThemeResource TextFillColorSecondary}" />
        <SolidColorBrush x:Key="PipeDividerBrush"    Color="{ThemeResource DividerStrokeColorDefault}" />
        <SolidColorBrush x:Key="PipeCodeBgBrush"     Color="{ThemeResource LayerFillColorDefault}" />
        <SolidColorBrush x:Key="PipeCardBgBrush"     Color="{ThemeResource CardBackgroundFillColorDefault}" />
        <SolidColorBrush x:Key="PipeCardBorderBrush" Color="{ThemeResource CardStrokeColorDefault}" />
    </Page.Resources>

    <Grid Background="{StaticResource N1Brush}">
        <Grid Margin="28,22,28,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />   <!-- header -->
                <RowDefinition Height="Auto" />   <!-- divider -->
                <RowDefinition Height="Auto" />   <!-- warning info bar -->
                <RowDefinition Height="*" />      <!-- main content -->
                <RowDefinition Height="Auto" />   <!-- status line -->
            </Grid.RowDefinitions>

            <!-- ═════════ HEADER ═════════ -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Bottom">
                    <TextBlock Text="Pipeline" Style="{StaticResource PageTitleText}" />
                    <TextBlock x:Name="RecipeSummaryText"
                               Style="{StaticResource PageSubtitleText}"
                               Text="Configure stages on the other pages to build your recipe."
                               VerticalAlignment="Bottom"
                               Margin="0,0,0,8" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="ImportRecipeButton"
                            Content="Load recipe"
                            Click="ImportRecipe_Click" />
                    <Button x:Name="ExportRecipeButton"
                            Content="Save recipe"
                            Click="ExportRecipe_Click" />
                    <Button x:Name="RefreshButton"
                            Content="Sync"
                            Click="Refresh_Click" />
                </StackPanel>
            </Grid>

            <!-- ═════════ DIVIDER ═════════ -->
            <Border Grid.Row="1" Style="{StaticResource SectionDivider}" />

            <!-- ═════════ WARNING INFOBAR ═════════ -->
            <InfoBar x:Name="WarningBar"
                     Grid.Row="2"
                     IsOpen="False"
                     IsClosable="False"
                     Severity="Warning"
                     Margin="0,0,0,10" />

            <!-- ═════════ MAIN CONTENT ═════════ -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ─── Stage rail (left) ─── -->
                <Border Grid.Column="0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Section header -->
                        <Border Grid.Row="0"
                                Padding="16,12,16,12"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Pipeline Stages"
                                           FontWeight="SemiBold"
                                           FontSize="14"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="StageCountText"
                                           Grid.Column="1"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="12,8,12,12">
                            <ItemsControl x:Name="StepsList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Vertical" Spacing="0" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- ─── Spec sidebar (right) ─── -->
                <ScrollViewer Grid.Column="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="SpecPanelHost" Spacing="8" />
                </ScrollViewer>
            </Grid>

            <!-- ═════════ STATUS LINE ═════════ -->
            <TextBlock x:Name="TelemetryLine"
                       Grid.Row="4"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="0,8,0,0" />
        </Grid>
    </Grid>
</Page>
