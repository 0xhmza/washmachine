-const wrap = (tree, pattern) => {
-	// Wrap the pattern in a non-capturing group.
-	return {
-		'type': 'group',
-		'behavior': 'ignore',
-		'body': [tree],
-		'raw': `(?:${ pattern })`
-	};
-};
