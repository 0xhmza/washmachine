-
-  let install =
-    lock.mode === 'yarn' ? YARN_CMD + ' add -W' : lock.mode + ' install'
-  print(
-    'Installing new caniuse-lite version\n' +
-      pico.yellow('$ ' + install + ' caniuse-lite baseline-browser-mapping') +
-      '\n'
