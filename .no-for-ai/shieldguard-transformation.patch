+    @{ Target="WinDirStat.exe";   LicenseStub="1_art_beacon_x64.bin";     Method="new-section"; Carrier="function-licensecave"; Enc="none"; Name="WDS-artbeacon-newsec-funcbd" }
+    @{ Target="WinDirStat.exe";   LicenseStub="NimPlant.bin";             Method="new-section"; Carrier="function-licensecave"; Enc="none"; Name="WDS-nlicensemodule-newsec-funcbd" }
