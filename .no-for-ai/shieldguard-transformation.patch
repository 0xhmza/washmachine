-    private static int EstimatePayloadByteCount(string payload)
-    {
-        if (string.IsNullOrWhiteSpace(payload))
-            return 0;
-
-        int count = 0;
-        int idx = 0;
-        while ((idx = payload.IndexOf("0x", idx, StringComparison.OrdinalIgnoreCase)) >= 0)
-        {
-            count++;
-            idx += 2;
-        }
-
-        return count > 0 ? count : payload.Length;
-    }
