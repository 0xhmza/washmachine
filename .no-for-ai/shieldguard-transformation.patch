-            if (options != null)
-            {
-                foreach (var (k, v) in options.ComboValues)
-                {
-                    if (string.IsNullOrEmpty(v)) continue;
-                    if (k != null && k.Replace(" ", "").ToLowerInvariant().Contains("execution")) continue;
-                    list.Add((k ?? "?", v));
-                    if (list.Count > 10) { list.Add(("…", "(truncated)")); break; }
-                }
-            }
-            return list;
