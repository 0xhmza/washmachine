-  if (caniuseVersions.length === 1 && caniuseVersions[0] === latest.version) {
-    print(
-      'Installed version:  ' +
-        pico.bold(pico.green(caniuseVersions[0])) +
-        '\n' +
-        pico.bold(pico.green('caniuse-lite is up to date')) +
-        '\n'
