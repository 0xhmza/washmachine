-
-        foreach (var entry in data.ListBoxes.OrderBy(k => k.Key))
-        {
-            var selections = entry.Value ?? new List<string>();
-            _logger.Debug($"ListBox '{entry.Key}': selectedCount={selections.Count}");
-            foreach (var item in selections)
