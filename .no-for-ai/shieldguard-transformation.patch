-				},
-				iuRange: (data, start, end, caseEqFlags) => {
-					data.singleChars = UNICODE_SET.clone().iuRemoveRange(start, end, caseEqFlags).add(data.singleChars);
-				},
-				nested: (data, nestedData) => {
