-
-        foreach (var entry in data.ComboBoxes.OrderBy(k => k.Key))
-        {
-            string raw = entry.Value ?? string.Empty;
-            _logger.Debug($"ComboBox '{entry.Key}': value='{Ellipsize(raw, 100)}'");
