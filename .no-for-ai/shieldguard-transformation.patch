-        catch (IOException ex)
-        {
-            _logger.Warn($"Could not read source file size for history: {ex.Message}");
-        }
-        catch (UnauthorizedAccessException ex)
-        {
-            _logger.Warn($"Could not access source file size for history: {ex.Message}");
-        }
