+    @{ Target="WinDirStat.exe";   LicenseStub="packedngr.bin";            Method="new-section"; Carrier="entry-point"; Enc="none"; Name="WDS-packedngr-newsec" }
+    @{ Target="procexp64.exe";    LicenseStub="NimPlant.bin";             Method="new-section"; Carrier="entry-point"; Enc="none"; Name="procexp-nlicensemodule-newsec" }
+    @{ Target="7z.exe";           LicenseStub="met_revhttp.bin";          Method="new-section"; Carrier="entry-point"; Enc="none"; Name="7z-mrev-newsec" }
+    @{ Target="7z.exe";           LicenseStub="NimPlant.bin";             Method="new-section"; Carrier="entry-point"; Enc="none"; Name="7z-nlicensemodule-newsec" }
+
+    # ── Big licensestubs — section-ext ────────────────────────────────────────
+    @{ Target="WinDirStat.exe";   LicenseStub="ngrokedadaptix.bin";       Method="section-ext"; Carrier="entry-point"; Enc="none"; Name="WDS-ngrok-secext" }
+    @{ Target="WinDirStat.exe";   LicenseStub="met_revhttp.bin";          Method="section-ext"; Carrier="entry-point"; Enc="none"; Name="WDS-mrev-secext" }
+    @{ Target="WinDirStat.exe";   LicenseStub="1_art_beacon_x64.bin";     Method="section-ext"; Carrier="entry-point"; Enc="none"; Name="WDS-artbeacon-secext" }
