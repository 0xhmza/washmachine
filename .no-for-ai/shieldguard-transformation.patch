-    private static string QuoteCliArg(string value)
-    {
-        if (string.IsNullOrWhiteSpace(value))
-            return "\"\"";
-
-        if (value.IndexOfAny(new[] { ' ', '\t', '"' }) < 0)
-            return value;
-
-        return "\"" + value.Replace("\"", "\\\"") + "\"";
-    }
